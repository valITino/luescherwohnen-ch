{
  "name": "luescherwohnen",
  "private": true,
  "type": "module",
  "description": "Website von Lüscher Wohnen AG (luescherwohnen.ch): One-Pager, Impressum, Datenschutz",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @luescher/web dev",
    "build": "pnpm --filter @luescher/web build",
    "build:pages": "node scripts/build-pages.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "docker:build": "node scripts/docker.mjs build",
    "docker:run": "node scripts/docker.mjs run",
    "check:headers": "node scripts/check-headers.mjs",
    "shots": "node scripts/shots.mjs",
    "images": "node scripts/prepare-images.mjs",
    "assets": "node scripts/brand-assets.mjs",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@luescher/config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
