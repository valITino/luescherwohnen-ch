# Kopie als deploy/kontakt.env anlegen; deploy/kontakt.env wird nicht versioniert.
# Zufälliges Secret mit mindestens 32 Zeichen, z. B.: openssl rand -hex 32
KONTAKT_SECRET=BITTE-SETZEN
# Firmenpostfach, das die Anfragen erhält (D-003), und Absenderadresse der Website.
KONTAKT_EMPFAENGER=info@example.com
KONTAKT_ABSENDER=website@example.com
# SMTP-Zugang des Mailanbieters (D-013).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# Wartezeit zwischen Prüfen und Senden (ms) und Anfragen je Anschluss und Stunde.
KONTAKT_MIN_AGE_MS=2000
RATE_LIMIT_PER_HOUR=10
