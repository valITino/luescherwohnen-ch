---
/**
 * 03 Aktuell: zwei Beiträge der bisherigen Startseite (docs/Homepage.docx, Bildschirmfotos) als
 * Bildgeschichten: Foto, Überschrift, ein Satz; der Rest hinter «Mehr lesen» (bleibt im HTML).
 * Texte gekürzt, Aussagen unverändert. Aktualität bestätigen (docs/TODO.md). Das Zitat aus dem
 * Interview steht jetzt bei «Über uns», neben dem Porträt (Entscheid 45).
 */
import { Picture } from 'astro:assets';
import Icon from '@luescher/ui/components/Icon.astro';
import druck from '../../assets/photos/aktuell-3d-druck.jpg';
import klang from '../../assets/photos/aktuell-klangboxen.jpg';
import SectionHead from '../SectionHead.astro';
---

<section data-lazy class="sheet sheet-paper" id="aktuell" aria-labelledby="aktuell-title">
  <div class="wrap">
    <SectionHead num="03" kicker="Aktuell" title="Neu bei uns." id="aktuell-title" />

    <div class="stories">
      <article class="card story sc-rise">
        <div class="story-media">
          <Picture
            src={druck}
            formats={['avif', 'webp']}
            widths={[360, 600, 1000]}
            sizes="(min-width: 64rem) 43rem, (min-width: 48rem) 45vw, 100vw"
            alt="Ausstellungsecke mit 3D-gedruckten Sesseln, Hocker und Beistelltisch auf orangem Teppich"
            class="story-photo sc-zoom"
            loading="lazy"
          />
        </div>
        <div class="story-body">
          <span class="tag">
            <Icon name="recycle" size={14} />
            Nachhaltigkeit
          </span>
          <h3 class="display h3 story-title">Es geht auch anders.</h3>
          <p>
            Neu im Sortiment: Designmöbel aus Norddeutschland, aus überwiegend recycelten
            Materialien energieeffizient und ressourcenschonend im 3D-Druck hergestellt.
          </p>
          <details class="more">
            <summary>
              <span class="more-icon" aria-hidden="true"></span>
              <span class="more-closed">Mehr lesen</span>
              <span class="more-opened">Weniger</span>
              <span class="sr-only">: Nachhaltigkeit</span>
            </summary>
            <div class="more-body">
              <p>
                Auch wir übernehmen Verantwortung und stehen zu unserer Haltung, möglichst
                nachhaltige Produkte zu verkaufen.
              </p>
            </div>
          </details>
        </div>
      </article>

      <article class="card story sc-rise">
        <div class="story-media">
          <Picture
            src={klang}
            formats={['avif', 'webp']}
            widths={[360, 600, 1000]}
            sizes="(min-width: 64rem) 43rem, (min-width: 48rem) 45vw, 100vw"
            alt="Rote Klangbox Senn und Klangbox Huuri aus Holz auf einem Sims mit Herbstlaub"
            class="story-photo sc-zoom"
            loading="lazy"
          />
        </div>
        <div class="story-body">
          <span class="tag">
            <Icon name="audio-lines" size={14} />
            Klangboxen
          </span>
          <h3 class="display h3 story-title">Entspannen und Energie tanken.</h3>
          <p>
            Unsere Klangboxen aus Holz entführen Sie mit wohltuenden Naturklängen weit weg vom
            hektischen Alltag.
          </p>
          <details class="more">
            <summary>
              <span class="more-icon" aria-hidden="true"></span>
              <span class="more-closed">Mehr lesen</span>
              <span class="more-opened">Weniger</span>
              <span class="sr-only">: Klangboxen</span>
            </summary>
            <div class="more-body">
              <p>
                Senn wird aus Schweizer Arvenholz, Huuri aus Schweizer Eichenholz gefertigt. Beide
                haben einen Bewegungssensor: Kommen Sie näher, erklingen Waldklänge, ein Kinderlied
                oder Kuhglocken und Naturjutz.
              </p>
            </div>
          </details>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .stories {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .story {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .story-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* Sandfläche, bis das Bild geladen ist */
    background-color: var(--sand);
  }

  .story-media :global(.story-photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-body {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .story-body > p {
    color: var(--fg-muted);
  }

  .story-body :global(.tag .icon) {
    color: var(--leaf-deep);
  }

  /* Nebeneinander rückt die zweite Geschichte nach der ersten nach (scroll.css, --sc-i). */
  @media (min-width: 48rem) {
    .stories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story:nth-child(2) {
      --sc-i: 1;
    }
  }

  /*
   * Kein eigener Scrollbereich: Ein Kasten mit `overflow: hidden` ist für den Browser einer, und
   * was darin am Scrollen hängt (scroll.css), mässe sich an ihm statt an der Seite. `clip`
   * schneidet gleich ab, ohne das. Nur dort, wo es die Bewegung gibt.
   */
  @supports (animation-timeline: view()) {
    .story {
      overflow: clip;
    }

    .story-media {
      overflow: clip;
    }
  }
</style>
