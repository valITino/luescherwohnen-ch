---
/**
 * Besuchszeile unter dem Hero: das Wichtigste für einen Besuch in einer ruhigen Zeile. Der
 * Live-Status («Geöffnet bis 18:30»), die Adresse, die Route und der Weg zu Öffnungszeiten und
 * Termin. Alles Weitere steht einmal, im Kontakt (Entscheid 45: jede Angabe nur einmal).
 * Texte: «Firmenstandorte» der bisherigen Website; Status aus hero.ts.
 */
import Icon from '@luescher/ui/components/Icon.astro';
import { company, mapUrl } from '../../config/site.ts';
---

<div class="visit">
  {/* Ohne Skript bleibt der Status verborgen; die Zeile schliesst ohne leere Stelle auf. */}
  <p class="visit-status" data-open-status data-breathe hidden>
    <i class="dot" aria-hidden="true"></i>
    <span data-open-status-text></span>
  </p>
  <p class="visit-address">
    <Icon name="store" size={18} />
    <span>
      {company.street}, {company.zip} {company.city}
    </span>
  </p>
  <p class="visit-links">
    <a class="btn-text" href={mapUrl} rel="noopener">
      Route planen <span class="sr-only">(Karte bei OpenStreetMap)</span>
      <Icon name="arrow-up-right" size={18} class="icon-shift" />
    </a>
    <a class="btn-text" href="#kontakt">
      Öffnungszeiten und Termin
      <Icon name="arrow-down-right" size={18} class="icon-shift" />
    </a>
  </p>
</div>

<style>
  .visit {
    display: grid;
    gap: 0.875rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--hairline);
  }

  .visit-status {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 1.75rem;
    color: var(--fg-strong);
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .visit-address {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ash);
  }

  .visit-address :global(.icon) {
    flex: none;
    color: var(--leaf-deep);
  }

  .visit-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  @media (min-width: 56rem) {
    .visit {
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }

    /* Ohne Status (ohne Skript) beginnt die Zeile mit der Adresse. */
    .visit-status[hidden] + .visit-address {
      grid-column: 1 / 3;
    }

    .visit-links {
      justify-content: end;
    }
  }
</style>
