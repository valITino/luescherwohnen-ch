---
/**
 * Haltung (ohne Nummer): drei grosse Aussagen. Beim Scrollen werden die Wörter eines nach dem
 * anderen von 20 % auf 100 % Deckkraft dunkel, im Takt des Scrollens (scroll.css, reines CSS).
 * Ohne Unterstützung, ohne Bewegung und im Druck stehen sie einfach da.
 * Zentriert auf Papierweiss mit grünem Schein; die Punkte darunter zählen die Aussagen mit.
 * Nur die drei Sätze, jeder mit seinem eigenen Bildschirm (Entscheid 45: die Erläuterungen
 * darunter wiederholten Hero, Service und Lieferung).
 *
 * Texte: sinngemäss und grösstenteils wörtlich von der bisherigen Website («Services – Unsere
 * Kompetenzen», «Services – Lieferung und Montage», docs/Homepage.docx).
 */

const statements = [
  'Wir nehmen uns Zeit für all Ihre Anliegen.',
  'Egal, wie gross Ihr Anliegen ist.',
  'Pünktlich, sauber und sorgfältig.',
];
---

<section data-lazy class="sheet sheet-paper haltung" aria-labelledby="haltung-title">
  <div class="wrap">
    <header class="haltung-head">
      {/* Ein Zwischenspiel ohne Nummer: Nummeriert sind nur die Ziele des Menüs (01 bis 05). */}
      <h2 id="haltung-title" class="kicker">
        Unsere Haltung
      </h2>
    </header>

    <ol class="statements">
      {statements.map((statement, index) => (
        <li class="statement">
          {/* Jedes Wort ein <span> im Fluss: Der Satz bleibt für Screenreader ein Satz. */}
          <p class="statement-text">
            {statement.split(' ').map((word, at) => (
              <>
                {at > 0 && ' '}
                <span class="w">{word}</span>
              </>
            ))}
          </p>
          <span class="statement-dots" aria-hidden="true">
            {statements.map((_, dot) => (
              <i class:list={['dot', { 'dot-off': dot > index }]} />
            ))}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .haltung {
    text-align: center;
  }

  .haltung-head {
    display: grid;
    justify-items: center;
  }

  .statements {
    display: grid;
  }

  .statement {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
    min-height: min(52svh, 38rem);
    padding-block: clamp(2.5rem, 8vw, 6rem);
  }

  /* Grüner Schein hinter jeder Aussage */
  .statement::before {
    position: absolute;
    inset: 4% -10%;
    z-index: 0;
    background: radial-gradient(
      closest-side,
      rgb(var(--sage-rgb) / 0.95) 0%,
      rgb(var(--sage-rgb) / 0.4) 55%,
      rgb(var(--sage-rgb) / 0) 100%
    );
    content: '';
    pointer-events: none;
  }

  .statement > * {
    position: relative;
  }

  .statement-text {
    max-width: 13em;
    color: var(--charcoal);
    font-size: var(--fs-statement);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.04;
    text-wrap: balance;
  }

  /* Platz des Worts im Satz: Danach richtet sich, wann es dunkel wird (scroll.css). */
  .w:nth-of-type(2) {
    --w: 1;
  }

  .w:nth-of-type(3) {
    --w: 2;
  }

  .w:nth-of-type(4) {
    --w: 3;
  }

  .w:nth-of-type(5) {
    --w: 4;
  }

  .w:nth-of-type(6) {
    --w: 5;
  }

  .w:nth-of-type(7) {
    --w: 6;
  }

  .w:nth-of-type(8) {
    --w: 7;
  }

  .w:nth-of-type(9) {
    --w: 8;
  }

  .w:nth-of-type(10) {
    --w: 9;
  }

  .statement-dots {
    display: inline-flex;
    gap: 0.75rem;
  }
</style>
