---
/**
 * 02 Service: vier nummerierte Schritte als riesige Wörter und die Karte «Lieferung nach Ihrem
 * Zeitplan» als eine Aussage. Grünlicher Bogen; die Überschrift bleibt auf Desktop links stehen.
 * Der Weg von der Beratung bis «Danach» zeichnet sich beim Scrollen: Eine grüne Linie wächst mit,
 * ihre Spitze bleibt auf Lesehöhe, und jeder Punkt wird grün, wenn sie ihn erreicht (scroll.css).
 * Texte nach «Services – Unsere Kompetenzen» und «Services – Lieferung und Montage» der
 * bisherigen Website (docs/Homepage.docx).
 */
import Icon from '@luescher/ui/components/Icon.astro';
import Words from '@luescher/ui/components/Words.astro';
import SectionHead from '../SectionHead.astro';

const steps = [
  {
    title: 'Beratung',
    text: 'Bei uns im Geschäft in Baden oder bei Ihnen zu Hause. Wir hören zu.',
  },
  {
    title: 'Planung',
    text: 'Unsere Innenarchitekten und Einrichtungsplaner entwickeln mit Ihnen die passende Lösung, auf Wunsch inklusive Visualisierung Ihrer Ideen.',
  },
  {
    title: 'Lieferung',
    text: 'Unsere eigenen Mitarbeiter liefern und montieren Möbel, Polstermöbel, Betten, Bodenbeläge und Textilien.',
  },
  {
    title: 'Danach',
    text: 'Wir bleiben Ihr Ansprechpartner: für Ergänzungen, Ersatzteile, Pflege und alle Fragen rund ums Einrichten.',
  },
];
---

<section data-lazy class="sheet sheet-sage on-sage" id="service" aria-labelledby="service-title">
  <div class="wrap">
    <div class="ablauf">
      <div class="ablauf-head">
        <SectionHead
          num="02"
          kicker="Service"
          title="Von der Idee bis zur Montage."
          id="service-title"
          lead="Wir unterstützen Sie in allen Phasen des Einrichtens."
        />
      </div>

      <ol class="process">
        {steps.map((step, index) => (
          <li class="process-step">
            <span class="process-num mono" aria-hidden="true">
              0{index + 1}
            </span>
            <div class="process-body">
              <h3 class="display process-title" aria-label={step.title}>
                <Words text={step.title} />
              </h3>
              <p class="process-text sc-rise">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {/* Lieferung als eine Aussage (Entscheid 45): Überschrift und ein Satz. */}
    <div class="delivery card sc-rise">
      <div class="delivery-intro">
        <p class="kicker">Lieferung und Montage</p>
        <h3 class="display h2 delivery-title" aria-label="Nach Ihrem Zeitplan.">
          <Words text="Nach Ihrem Zeitplan." />
        </h3>
      </div>
      <p class="delivery-text">
        <Icon name="truck" size={24} />
        <span>
          Sie bestimmen den exakten Lieferzeitpunkt, auch an einer Randzeit oder am Wochenende.
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  /* ---------- Vier Schritte ---------- */

  .ablauf {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .process {
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-left: 1.75rem;
    border-left: 1px solid var(--border-strong);
  }

  .process-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: start;
    gap: 0.25rem;
  }

  /*
   * Die grüne Linie über der grauen: Ohne Bewegung steht sie ganz da. Mit dem Scrollen wächst sie
   * von oben (scroll.css), nur über `scale`, darum der Ursprung oben.
   */
  .process::after {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1.5px;
    width: 2px;
    border-radius: 1px;
    background-color: var(--leaf-edge);
    content: '';
    pointer-events: none;
    transform-origin: 50% 0;
  }

  /* Punkt auf der Linie (liegt über ihr) */
  .process-step::before {
    position: absolute;
    top: clamp(0.75rem, 2.2vw, 2rem);
    left: calc(-1.75rem - 6px);
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--leaf-edge);
    border-radius: 50%;
    background-color: var(--leaf);
    content: '';
  }

  .process-num {
    padding-top: clamp(0.5rem, 2vw, 1.75rem);
    color: var(--fg-muted);
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
  }

  /* minmax(0, 1fr): Ein langes Wort darf die Spalte nicht breiter machen als den Bildschirm. */
  .process-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }

  .process-title {
    font-size: clamp(1.875rem, 0.9rem + 4.6vw, 5.5rem);
  }

  .process-text {
    max-width: 26em;
    color: var(--fg-muted);
    font-size: var(--fs-lead);
    letter-spacing: -0.015em;
    line-height: 1.36;
  }

  /* ---------- Lieferung ---------- */

  .delivery {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding: clamp(1.5rem, 0.6rem + 3.6vw, 4.5rem);
    border-radius: var(--r-stage);
    background-image: radial-gradient(
      36rem 24rem at 100% 0%,
      rgb(var(--leaf-rgb) / 0.12),
      transparent 70%
    );
  }

  .delivery-intro {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .delivery-title {
    max-width: 8em;
  }

  .delivery-text {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    max-width: 26em;
    color: var(--fg-strong);
    font-size: var(--fs-h4);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .delivery-text :global(.icon) {
    margin-top: 0.15em;
    color: var(--leaf-deep);
  }

  @media (min-width: 64rem) {
    .ablauf {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: clamp(2rem, 5vw, 5rem);
    }

    /* Die Überschrift bleibt stehen, während die Schritte vorbeiziehen */
    .ablauf-head {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }

    .process {
      padding-left: clamp(2rem, 4vw, 3.75rem);
    }

    .process-step::before {
      left: calc(-1 * clamp(2rem, 4vw, 3.75rem) - 6px);
    }

    .process-step {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }

    .delivery {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }
  }
</style>
