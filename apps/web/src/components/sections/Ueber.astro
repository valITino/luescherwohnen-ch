---
/**
 * 04 Über uns: Porträt im Sucher-Rahmen, daneben Überschrift, Lead und das Zitat des Mannes im
 * Porträt (Gesicht und Stimme); Haltung und «Wir stehen für» hinter «Mehr über uns». Darunter das
 * Team (Fotos und Aufgaben von der aktuellen Website, Entscheid 46) und die Firmengeschichte
 * «Jahr für Jahr», die mit dem Scrollen weitergeht (years.ts, Entscheid 50). Die Standorte stehen
 * im Kontakt (Entscheid 45).
 * Beim Hereinscrollen stellt der Sucher scharf: Die Ecken rücken an ihren Platz, während das
 * Foto sich setzt (scroll.css, an der Scrollposition, nicht nach Zeit).
 * Texte und Jahreszahlen: «Unternehmen», «Firmengeschichte», «Firmenstandorte» der bisherigen
 * Website (docs/Homepage.docx). Widersprüchliche Angaben (Generation, Funktion) bleiben weg.
 */
import { Picture } from 'astro:assets';
import Icon from '@luescher/ui/components/Icon.astro';
import bruno from '../../assets/photos/portrait-bruno-laengle.jpg';
import hans from '../../assets/photos/portrait-hans-luescher.jpg';
import michael from '../../assets/photos/portrait-michael-laengle.jpg';
import teamIris from '../../assets/photos/team-iris-laengle.jpg';
import teamMichael from '../../assets/photos/team-michael-laengle.jpg';
import { company } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const values = [
  'Erstklassige und nachhaltige Produkte, hinter denen wir hundertprozentig stehen können.',
  'Fachkompetenz, Inspiration, Ideen und eine kompetente, seriöse Beratung.',
  'Umfassende Dienstleistungen von der Planung bis hin zur Montage.',
  'Ein Umfeld, in dem Sie in Ruhe und ohne Zeitdruck Ihr Zuhause einrichten können.',
  'Qualitativ beste Arbeit, Pünktlichkeit und Zuverlässigkeit.',
];

/*
 * Unser Team: Namen, Aufgaben und Fotos aus dem Abschnitt «Unser Team» der aktuellen Website
 * (luescherwohnen.ch, abgerufen am 21.11.2026; docs/ressources/website-2026/QUELLE.md). Michael
 * Längle als «Geschäftsleiter» wie im Impressum (Entscheid 23; die Website sagt «Geschäftsführer»,
 * W3). Ohne Foto auf der Website: die Initialen statt eines Bildes.
 */
const team = [
  { name: company.management, role: 'Geschäftsleiter', photo: teamMichael },
  { name: 'Christina Stahl', role: 'Verkauf' },
  { name: 'Iris Längle', role: 'Administration, Buchhaltung, Finanzen', photo: teamIris },
  { name: 'Vlavono Macoso', role: 'Lieferung und Montage' },
];
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');

const history = [
  {
    year: '1946',
    text: 'Die Brüder Hans und Arthur Lüscher gründen die Firma Wohnkonzeption Lüscher, ein Möbelgeschäft mit eigener Polsterwerkstätte.',
    photo: { src: hans, alt: 'Hans Lüscher, historisches Zeitungsporträt' },
  },
  {
    year: '1949',
    text: 'Nach der Trennung der beiden Brüder führt Hans Lüscher die Firma allein weiter.',
  },
  {
    year: '1959',
    text: 'Bezug der Liegenschaft an der Weiten Gasse 9: Das Sortiment zeigt sich neu auf 6 Etagen und rund 1200 m². Sie ist bis heute der Hauptsitz.',
  },
  {
    year: '1983',
    text: 'Nach dem Tod von Hans Lüscher übernimmt Bruno Längle die Firma.',
    photo: { src: bruno, alt: 'Bruno Längle am Schreibtisch, historisches Zeitungsfoto' },
  },
  {
    year: '2010',
    text: 'Aus der Einzelfirma Wohnkonzeption Lüscher wird die Lüscher Wohnen AG, vollständig in Familienbesitz.',
  },
  {
    year: 'Heute',
    text: `${company.management} führt das Familienunternehmen.`,
  },
];
---

<section data-lazy class="sheet sheet-sage on-sage" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap">
    <div class="about">
      <div class="portrait">
        <figure class="portrait-frame sc-rise">
          <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
          {/* Eigener Ausschnitt: Das Foto gleitet darin (scroll.css), ohne in den Bildtext zu ragen. */}
          <div class="portrait-media">
            <Picture
              src={michael}
              formats={['avif', 'webp']}
              widths={[400, 800]}
              sizes="(min-width: 56rem) 34rem, 100vw"
              alt={`Porträt von ${company.management} vor Vorhangstoff-Mustern`}
              class="portrait-photo sc-drift"
              loading="lazy"
            />
          </div>
          <figcaption class="portrait-caption">
            <span class="label-up">{company.management}</span>
            <span>Geschäftsleiter</span>
          </figcaption>
        </figure>
      </div>

      <div class="about-main">
        <SectionHead
          num="04"
          kicker="Über uns"
          title={'Ein Familien\u00ADunternehmen aus Baden.'}
          id="ueber-title"
        />

        <div class="about-text">
          <p class="lead">
            Seit 1946 richten wir Wohnungen und Häuser ein. Für uns steht der persönliche Kontakt
            und Ihre Bedürfnisse im Vordergrund.
          </p>
        </div>

        {/* Gesicht und Stimme: Das Zitat stammt vom Mann im Porträt (Entscheid 45). */}
        <figure class="voice sc-rise">
          <blockquote class="voice-quote">
            <p>
              «Wichtig ist, dass sich beide Parteien – Verkäufer und Kundschaft – Zeit nehmen für
              das Thema. Dass sie einander zuhören und Fragen stellen.»
            </p>
          </blockquote>
          <figcaption class="voice-source">
            Michael Längle im Interview zum Bettenkauf in «Einrichten Schweiz», Ausgabe 125, dem
            Organ des Verbandes einrichtenschweiz
          </figcaption>
        </figure>

        <details class="more about-more">
          <summary>
            <span class="more-icon" aria-hidden="true"></span>
            <span class="more-closed">Mehr über uns</span>
            <span class="more-opened">Weniger</span>
          </summary>
          <div class="more-body">
            <p>
              Unsere Grösse und unsere Lage fernab der Grossstadthektik geben uns die Möglichkeit,
              Ihnen die Zeit und Aufmerksamkeit zu schenken, die es braucht, um das für Sie richtige
              Produkt zu finden. Bei uns im Laden oder bei Ihnen zu Hause, zu dem für Sie besten
              Zeitpunkt.
            </p>
            <p>
              Nebst Ersteinrichtungen sind vor allem Neueinrichtungen unsere Stärke. Unsere
              Erfahrung erspart Ihnen unnötige Überraschungen und Aufwand.
            </p>
            <p class="kicker values-kicker">Wir stehen für</p>
            <ul class="values-list">
              {values.map((value) => (
                <li>
                  <Icon name="check" size={20} />
                  <span>{value}</span>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>

    {/* Unser Team: die Menschen hinter «Wir nehmen uns Zeit». Beim Hereinscrollen rücken sie
        einer nach dem anderen nach, die Fotos setzen sich aus einem leichten Zoom (scroll.css). */}
    <div class="team">
      <h3 class="display h3 team-title sc-rise">Unser Team</h3>
      <ul class="team-list">
        {team.map((member) => (
          <li class="member sc-rise">
            <div class="member-photo">
              {member.photo ? (
                <Picture
                  src={member.photo}
                  formats={['avif', 'webp']}
                  widths={[240, 480]}
                  sizes="(min-width: 48rem) 8rem, 6.5rem"
                  alt={`Porträt von ${member.name}`}
                  class="member-img sc-zoom"
                  loading="lazy"
                />
              ) : (
                <span class="member-initials sc-zoom" aria-hidden="true">
                  {initials(member.name)}
                </span>
              )}
            </div>
            <p class="member-name">{member.name}</p>
            <p class="member-role">{member.role}</p>
          </li>
        ))}
      </ul>
    </div>

    {/*
      Firmengeschichte «Jahr für Jahr». Im HTML steht eine Zeitleiste mit allen sechs Momenten:
      So bleibt sie ohne Skript, bei reduzierter Bewegung, in niedrigen Fenstern und im Druck.
      Sonst wird sie zur Bühne, auf der die Jahre mit dem Scrollen weitergehen (years.ts und
      scroll.css): Die Bühne bleibt unter dem Header stehen, die Linie der Achse wächst, und die
      Karte des nächsten Jahrs schiebt sich über die des vorherigen. Die Knöpfe der Achse und
      «Weiter» bleiben als Abkürzung; ohne Skript sind sie verborgen (hidden).
    */}
    <div class="history" data-years>
      <div class="history-stage">
        <h3 class="display h3 history-title sc-rise">Firmengeschichte</h3>
        <div class="years sc-rise">
          <div
            class="yr-axis"
            role="group"
            aria-label="Jahre der Firmengeschichte"
            data-years-axis
            hidden
          >
            <span class="yr-track" aria-hidden="true"></span>
            <ol class="yr-stops">
              {history.map((entry) => (
                <li>
                  <button type="button" class="yr-btn" data-years-to>
                    {entry.year}
                  </button>
                </li>
              ))}
            </ol>
          </div>
          <ol class="timeline">
            {history.map((entry) => (
              <li class="moment" id={`jahr-${entry.year.toLowerCase()}`} data-years-item>
                <div class="moment-card">
                  <p class="moment-year">{entry.year}</p>
                  <div class="moment-body">
                    {entry.photo && (
                      <Picture
                        src={entry.photo.src}
                        formats={['avif', 'webp']}
                        widths={[160, 320]}
                        sizes="10rem"
                        alt={entry.photo.alt}
                        class="moment-photo"
                        loading="lazy"
                      />
                    )}
                    <p>{entry.text}</p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
          <button type="button" class="yr-next" data-years-next hidden>
            <span data-years-next-text>Weiter</span>
            <span class="yr-next-icon" aria-hidden="true">
              <Icon name="arrow-right" size={16} />
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .about-main {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-text {
    display: grid;
    gap: 1rem;
    max-width: 38em;
  }

  .about-text p:not(.lead) {
    color: var(--fg-muted);
  }

  /* ---------- Porträt im Sucher ---------- */

  .portrait {
    position: relative;
  }

  .portrait-frame {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    height: 100%;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background-color: var(--paper);
  }

  /* Das Foto füllt seine Zeile des Rahmens; was beim Gleiten übersteht, schneidet sie ab. */
  .portrait-media {
    display: grid;
    min-height: 0;
    overflow: hidden;
  }

  .portrait-frame :global(.portrait-photo) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(20rem, 60vw, 36rem);
    max-height: 44rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /*
   * Die Ecken gehören zum Foto, nicht zum ganzen Rahmen: Sie liegen in dessen Zeile des Rasters
   * (ein absolut gesetztes Kind nimmt sie als Bezug), über dem Bildtext bleibt nichts.
   */
  .portrait-corner {
    grid-area: 1 / 1 / 2 / 2;
  }

  .portrait-caption {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem 1.5rem;
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .portrait-caption .label-up {
    color: var(--charcoal);
  }

  /* Die Ecken liegen wie ein Sucher über dem Bild. */
  .portrait-corner {
    position: absolute;
    z-index: 1;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid rgb(var(--paper-rgb) / 0.95);
  }

  /* `--from`: von wo die Ecke beim Scharfstellen anrückt (scroll.css). */
  .portrait-corner-tl {
    --from: -0.875rem -0.875rem;

    top: 1.25rem;
    left: 1.25rem;
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner-tr {
    --from: 0.875rem -0.875rem;

    top: 1.25rem;
    right: 1.25rem;
    border-bottom: 0;
    border-left: 0;
  }

  .portrait-corner-bl {
    --from: -0.875rem 0.875rem;

    bottom: 1.25rem;
    left: 1.25rem;
    border-top: 0;
    border-right: 0;
  }

  .portrait-corner-br {
    --from: 0.875rem 0.875rem;

    right: 1.25rem;
    bottom: 1.25rem;
    border-top: 0;
    border-left: 0;
  }

  /* ---------- Gesicht und Stimme ---------- */

  .voice {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 3px solid var(--leaf-edge);
  }

  .voice-quote p {
    color: var(--charcoal);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    text-wrap: pretty;
  }

  .voice-source {
    max-width: 36em;
    color: var(--moss);
    font-size: var(--fs-meta);
  }

  .about-more .more-body > p:not(.kicker) {
    max-width: 38em;
    color: var(--fg-muted);
  }

  .values-kicker {
    margin-top: 0.5rem;
  }

  .values-list {
    display: grid;
    gap: 0.875rem;
  }

  .values-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .values-list :global(.icon) {
    margin-top: 0.15em;
    color: var(--leaf-deep);
  }

  /* ---------- Unser Team ---------- */

  .team {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .team-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }

  .member {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.25rem;
  }

  .member-photo {
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 5rem + 4vw, 8rem);
    aspect-ratio: 1;
    margin-bottom: 0.75rem;
    /* Der Kreis schneidet ab: Foto und Initialen setzen sich darin aus einem leichten Zoom. */
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--leaf-edge),
      0 0 0 0.375rem rgb(var(--leaf-rgb) / 0.12);
  }

  .member-photo :global(picture),
  .member-photo :global(.member-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .member-photo :global(.member-img) {
    border-radius: 50%;
    object-fit: cover;
  }

  /* Ohne Foto: die Initialen auf Salbei, ruhig und ohne Platzhalterbild. */
  .member-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--sage);
    color: var(--moss);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .member-name {
    color: var(--charcoal);
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .member-role {
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  /* Nebeneinander rücken die Personen eine nach der anderen nach (scroll.css, --sc-i). */
  .member {
    --sc-y: 2rem;
    --sc-step: 1.25rem;
  }

  .member:nth-child(even) {
    --sc-i: 1;
  }

  @media (min-width: 48rem) {
    .team-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .member:nth-child(3) {
      --sc-i: 2;
    }

    .member:nth-child(4) {
      --sc-i: 3;
    }
  }

  /* ---------- Firmengeschichte ---------- */

  /*
   * Grundform: eine Zeitleiste mit allen Momenten (ohne Skript, bei reduzierter Bewegung, in
   * niedrigen Fenstern, im Druck). Die Bühne, auf der die Jahre mit dem Scrollen weitergehen,
   * steht samt ihrer Bewegung in scroll.css: Dort gilt eine Bedingung für beides.
   */
  .history {
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .history-stage {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .timeline {
    display: grid;
    gap: 2rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--border-strong);
  }

  .moment {
    position: relative;
  }

  /* Punkt auf der Linie */
  .moment::before {
    position: absolute;
    top: 0.75rem;
    left: calc(-1.75rem - 6px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--leaf-edge);
    border-radius: 50%;
    background-color: var(--leaf);
    content: '';
  }

  .moment-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .moment-year {
    color: var(--charcoal);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: var(--fw-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-display);
    line-height: 1;
  }

  .moment-body {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    max-width: 30em;
    color: var(--fg-muted);
  }

  .moment-body :global(.moment-photo) {
    display: block;
    width: 7.5rem;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-input);
    filter: sepia(0.15);
  }

  /*
   * ---------- Achse und «Weiter»: nur auf der Bühne (scroll.css zeigt sie) ----------
   * Sechs Jahre als Knöpfe auf einer Linie. Der Punkt des aktuellen Jahrs ist gross und grün,
   * frühere sind grün gefüllt (years.ts: aria-current, data-past). Die grüne Linie wächst bis zum
   * aktuellen Jahr: mit dem Scrollen, wo der Browser das kann (scroll.css), sonst in Schritten.
   */
  .yr-axis,
  .yr-next {
    display: none;
  }

  .yr-stops {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  /* Von der Mitte der ersten bis zur Mitte der letzten Spalte */
  .yr-track {
    position: absolute;
    top: calc(1rem - 0.5px);
    right: calc(100% / 12);
    left: calc(100% / 12);
    height: 1px;
    background-color: var(--steel);
    pointer-events: none;
  }

  .yr-track::after {
    position: absolute;
    inset: -1px 0;
    background-color: var(--leaf-edge);
    content: '';
    scale: var(--yr-p, 0) 1;
    transform-origin: 0 50%;
    transition: scale var(--dur-4) var(--ease-expo);
  }

  .yr-btn {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.625rem;
    width: 100%;
    min-height: 2.75rem;
    padding-block: 1rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--moss);
    font-family: var(--ff-mono);
    font-size: var(--fs-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease);
  }

  /* Punkt auf der Achse */
  .yr-btn::before {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -0.375rem;
    border: 2px solid var(--leaf-edge);
    border-radius: 50%;
    background-color: var(--sage);
    content: '';
    transition:
      background-color var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease-out);
  }

  .yr-btn[data-past]::before {
    background-color: var(--leaf);
  }

  .yr-btn[aria-current] {
    color: var(--charcoal);
    font-weight: 600;
  }

  .yr-btn[aria-current]::before {
    background-color: var(--leaf);
    transform: scale(1.5);
  }

  @media (hover: hover) and (pointer: fine) {
    .yr-btn:hover {
      color: var(--charcoal);
    }
  }

  .yr-next {
    align-items: center;
    justify-self: start;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.4375rem 0 1rem;
    border: 1px solid var(--steel);
    border-radius: var(--r-pill);
    background-color: var(--paper);
    color: var(--charcoal);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease);
  }

  .yr-next-icon {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background-color: var(--leaf);
    color: var(--ink);
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .yr-next:hover {
      border-color: var(--leaf-deep);
    }

    .yr-next:hover .yr-next-icon {
      transform: translateX(2px);
    }
  }

  @media (min-width: 40rem) {
    .yr-btn {
      font-size: var(--fs-small);
    }
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
    }

    /* Der Rahmen ist so hoch wie die Spalte daneben: Das Foto füllt ihn bis zum Bildtext. */
    .portrait-frame :global(.portrait-photo) {
      max-height: none;
    }
  }

  @media (min-width: 64rem) {
    .history-stage,
    .team {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: start;
    }

    /* Als Zeitleiste waagrecht: drei Momente pro Reihe, die Linie oben */
    .timeline {
