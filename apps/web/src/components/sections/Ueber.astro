---
/**
 * 04 Über uns: Porträt im Sucher-Rahmen, daneben Überschrift, Lead und das Zitat des Mannes im
 * Porträt (Gesicht und Stimme); Haltung und «Wir stehen für» hinter «Mehr über uns». Darunter das
 * Team (Fotos und Aufgaben von der aktuellen Website, Entscheid 46) und die Firmengeschichte
 * «Jahr für Jahr» (choice.ts). Die Standorte stehen im Kontakt (Entscheid 45).
 * Texte und Jahreszahlen: «Unternehmen», «Firmengeschichte», «Firmenstandorte» der bisherigen
 * Website (docs/Homepage.docx). Widersprüchliche Angaben (Generation, Funktion) bleiben weg.
 */
import { Picture } from 'astro:assets';
import Icon from '@luescher/ui/components/Icon.astro';
import bruno from '../../assets/photos/portrait-bruno-laengle.jpg';
import hans from '../../assets/photos/portrait-hans-luescher.jpg';
import michael from '../../assets/photos/portrait-michael-laengle.jpg';
import teamIris from '../../assets/photos/team-iris-laengle.jpg';
import teamMichael from '../../assets/photos/team-michael-laengle.jpg';
import { company } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const values = [
  'Erstklassige und nachhaltige Produkte, hinter denen wir hundertprozentig stehen können.',
  'Fachkompetenz, Inspiration, Ideen und eine kompetente, seriöse Beratung.',
  'Umfassende Dienstleistungen von der Planung bis hin zur Montage.',
  'Ein Umfeld, in dem Sie in Ruhe und ohne Zeitdruck Ihr Zuhause einrichten können.',
  'Qualitativ beste Arbeit, Pünktlichkeit und Zuverlässigkeit.',
];

/*
 * Unser Team: Namen, Aufgaben und Fotos aus dem Abschnitt «Unser Team» der aktuellen Website
 * (luescherwohnen.ch, abgerufen am 21.11.2026; docs/ressources/website-2026/QUELLE.md). Michael
 * Längle als «Geschäftsleiter» wie im Impressum (Entscheid 23; die Website sagt «Geschäftsführer»,
 * W3). Ohne Foto auf der Website: die Initialen statt eines Bildes.
 */
const team = [
  { name: company.management, role: 'Geschäftsleiter', photo: teamMichael },
  { name: 'Christina Stahl', role: 'Verkauf' },
  { name: 'Iris Längle', role: 'Administration, Buchhaltung, Finanzen', photo: teamIris },
  { name: 'Vlavono Macoso', role: 'Lieferung und Montage' },
];
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');

const history = [
  {
    year: '1946',
    text: 'Die Brüder Hans und Arthur Lüscher gründen die Firma Wohnkonzeption Lüscher, ein Möbelgeschäft mit eigener Polsterwerkstätte.',
    photo: { src: hans, alt: 'Hans Lüscher, historisches Zeitungsporträt' },
  },
  {
    year: '1949',
    text: 'Nach der Trennung der beiden Brüder führt Hans Lüscher die Firma allein weiter.',
  },
  {
    year: '1959',
    text: 'Bezug der Liegenschaft an der Weiten Gasse 9: Das Sortiment zeigt sich neu auf 6 Etagen und rund 1200 m². Sie ist bis heute der Hauptsitz.',
  },
  {
    year: '1983',
    text: 'Nach dem Tod von Hans Lüscher übernimmt Bruno Längle die Firma.',
    photo: { src: bruno, alt: 'Bruno Längle am Schreibtisch, historisches Zeitungsfoto' },
  },
  {
    year: '2010',
    text: 'Aus der Einzelfirma Wohnkonzeption Lüscher wird die Lüscher Wohnen AG, vollständig in Familienbesitz.',
  },
  {
    year: 'Heute',
    text: `${company.management} führt das Familienunternehmen.`,
  },
];
---

<section data-lazy class="sheet sheet-sage on-sage" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap">
    <div class="about">
      <div class="portrait" data-enter>
        <figure class="portrait-frame enter-unveil" data-enter>
          <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
          <Picture
            src={michael}
            formats={['avif', 'webp']}
            widths={[400, 800]}
            sizes="(min-width: 56rem) 34rem, 100vw"
            alt={`Porträt von ${company.management} vor Vorhangstoff-Mustern`}
            class="portrait-photo"
            loading="lazy"
          />
          <figcaption class="portrait-caption">
            <span class="label-up">{company.management}</span>
            <span>Geschäftsleiter</span>
          </figcaption>
        </figure>
      </div>

      <div class="about-main">
        <SectionHead
          num="04"
          kicker="Über uns"
          title={'Ein Familien\u00ADunternehmen aus Baden.'}
          id="ueber-title"
        />

        <div class="about-text">
          <p class="lead">
            Seit 1946 richten wir Wohnungen und Häuser ein. Für uns steht der persönliche Kontakt
            und Ihre Bedürfnisse im Vordergrund.
          </p>
        </div>

        {/* Gesicht und Stimme: Das Zitat stammt vom Mann im Porträt (Entscheid 45). */}
        <figure class="voice">
          <blockquote class="voice-quote">
            <p>
              «Wichtig ist, dass sich beide Parteien – Verkäufer und Kundschaft – Zeit nehmen für
              das Thema. Dass sie einander zuhören und Fragen stellen.»
            </p>
          </blockquote>
          <figcaption class="voice-source">
            Michael Längle im Interview zum Bettenkauf in «Einrichten Schweiz», Ausgabe 125, dem
            Organ des Verbandes einrichtenschweiz
          </figcaption>
        </figure>

        <details class="more about-more">
          <summary>
            <span class="more-icon" aria-hidden="true"></span>
            <span class="more-closed">Mehr über uns</span>
            <span class="more-opened">Weniger</span>
          </summary>
          <div class="more-body">
            <p>
              Unsere Grösse und unsere Lage fernab der Grossstadthektik geben uns die Möglichkeit,
              Ihnen die Zeit und Aufmerksamkeit zu schenken, die es braucht, um das für Sie richtige
              Produkt zu finden. Bei uns im Laden oder bei Ihnen zu Hause, zu dem für Sie besten
              Zeitpunkt.
            </p>
            <p>
              Nebst Ersteinrichtungen sind vor allem Neueinrichtungen unsere Stärke. Unsere
              Erfahrung erspart Ihnen unnötige Überraschungen und Aufwand.
            </p>
            <p class="kicker values-kicker">Wir stehen für</p>
            <ul class="values-list">
              {values.map((value) => (
                <li>
                  <Icon name="check" size={20} />
                  <span>{value}</span>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>

    {/* Unser Team: die Menschen hinter «Wir nehmen uns Zeit». Die Fotos öffnen sich wie die Blende
        im Hero, einer nach dem anderen (reveal.ts setzt data-enter). */}
    <div class="team">
      <h3 class="display h3 team-title">Unser Team</h3>
      <ul class="team-list" data-enter>
        {team.map((member) => (
          <li class="member">
            <div class="member-photo">
              {member.photo ? (
                <Picture
                  src={member.photo}
                  formats={['avif', 'webp']}
                  widths={[240, 480]}
                  sizes="(min-width: 48rem) 8rem, 6.5rem"
                  alt={`Porträt von ${member.name}`}
                  class="member-img"
                  loading="lazy"
                />
              ) : (
                <span class="member-initials" aria-hidden="true">
                  {initials(member.name)}
                </span>
              )}
            </div>
            <p class="member-name">{member.name}</p>
            <p class="member-role">{member.role}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="history">
      <h3 class="display h3 history-title">Firmengeschichte</h3>
      {/*
        «Jahr für Jahr» (choice.ts): eine Achse mit den Jahren und ein Moment. Ohne Skript die
        Zeitleiste mit allen Momenten. Die grosse Jahreszahl ist nur Gestaltung (CSS, ohne Text).
      */}
      <div class="years" data-years>
        <span class="yr-track" aria-hidden="true"></span>
        <ol class="timeline">
          {history.map((entry) => (
            <li
              class="moment"
              id={`jahr-${entry.year.toLowerCase()}`}
              data-choice-item
              data-choice-name={entry.year}
            >
              <span class="moment-year" data-choice-head data-choice-button="yr-btn">
                {entry.year}
              </span>
              <div class="moment-panel" data-choice-panel>
                <span class="yr-big" data-year={entry.year} aria-hidden="true"></span>
                <div class="moment-body">
                  {entry.photo && (
                    <Picture
                      src={entry.photo.src}
                      formats={['avif', 'webp']}
                      widths={[160, 320]}
                      sizes="10rem"
                      alt={entry.photo.alt}
                      class="moment-photo"
                      loading="lazy"
                    />
                  )}
                  <p>{entry.text}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
        <button type="button" class="yr-next" data-choice-next hidden>
          <span data-choice-next-text>Weiter</span>
          <span class="yr-next-icon" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .about-main {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-text {
    display: grid;
    gap: 1rem;
    max-width: 38em;
  }

  .about-text p:not(.lead) {
    color: var(--fg-muted);
  }

  /* ---------- Porträt im Sucher ---------- */

  .portrait {
    position: relative;
  }

  .portrait-frame {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    height: 100%;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background-color: var(--paper);
  }

  .portrait-frame :global(.portrait-photo) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(20rem, 60vw, 36rem);
    max-height: 44rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  /*
   * Ecken und Linie gehören zum Foto, nicht zum ganzen Rahmen: Sie liegen in dessen Zeile des
   * Rasters (ein absolut gesetztes Kind nimmt sie als Bezug), über dem Bildtext bleibt nichts.
   */
  .portrait-corner,
  .portrait-frame::after {
    grid-area: 1 / 1 / 2 / 2;
  }

  .portrait-caption {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem 1.5rem;
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .portrait-caption .label-up {
    color: var(--charcoal);
  }

  /* Die Ecken liegen wie ein Sucher über dem Bild. */
  .portrait-corner {
    position: absolute;
    z-index: 1;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid rgb(var(--paper-rgb) / 0.95);
  }

  .portrait-corner-tl {
    top: 1.25rem;
    left: 1.25rem;
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner-tr {
    top: 1.25rem;
    right: 1.25rem;
    border-bottom: 0;
    border-left: 0;
  }

  .portrait-corner-bl {
    bottom: 1.25rem;
    left: 1.25rem;
    border-top: 0;
    border-right: 0;
  }

  .portrait-corner-br {
    right: 1.25rem;
    bottom: 1.25rem;
    border-top: 0;
    border-left: 0;
  }

  /* ---------- Gesicht und Stimme ---------- */

  .voice {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding-left: clamp(1rem, 2vw, 1.5rem);
    border-left: 3px solid var(--leaf-edge);
  }

  .voice-quote p {
    color: var(--charcoal);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.25;
    text-wrap: pretty;
  }

  .voice-source {
    max-width: 36em;
    color: var(--moss);
    font-size: var(--fs-meta);
  }

  .about-more .more-body > p:not(.kicker) {
    max-width: 38em;
    color: var(--fg-muted);
  }

  .values-kicker {
    margin-top: 0.5rem;
  }

  .values-list {
    display: grid;
    gap: 0.875rem;
  }

  .values-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .values-list :global(.icon) {
    margin-top: 0.15em;
    color: var(--leaf-deep);
  }

  /*
   * Auftritt, sobald die Sektion ins Bild kommt (reveal.ts setzt data-enter): Das Bild öffnet sich
   * wie alle Bilder der Seite von unten (enter-unveil, components.css), der Sucher stellt scharf
   * (die Ecken rücken weich bremsend an ihren Platz, ohne Überschwingen), eine feine grüne Linie
   * tastet das Bild einmal ab; die Werte erscheinen im Abstand --stagger nacheinander.
   *
   * Die Linie ist ein 0.375rem hohes Band am unteren Rand einer Ebene, die so hoch ist wie das
   * Foto (ohne Bildtext). Die Ebene fährt von ganz oben (-100 %, Band knapp über dem Bild) nach
   * unten und endet an der Unterkante des Fotos; bewegt wird nur transform, der Rahmen schneidet
   * ab, was darüber liegt.
   */
  .portrait-frame::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(
      to bottom,
      rgb(var(--leaf-rgb) / 0) calc(100% - 0.375rem),
      rgb(var(--leaf-rgb) / 0.85) calc(100% - 0.1875rem),
      rgb(var(--leaf-rgb) / 0) 100%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .portrait[data-enter='wait'] .portrait-corner,
  .portrait[data-enter='wait'] .portrait-caption {
    opacity: 0;
  }

  .portrait[data-enter='in'] .portrait-caption {
    animation: about-rise 500ms var(--ease) 260ms backwards;
  }

  .portrait[data-enter='in'] .portrait-corner {
    animation: about-focus var(--dur-4) var(--ease-expo) 140ms backwards;
  }

  /*
   * Die oberen Ecken sind hell wie der leere Rahmen: Sie rücken erst an, wenn das aufsteigende Foto
   * sie erreicht (nach gut 0,4 s), sonst wären sie fast am Ziel, bevor man sie sieht. Sie enden
   * nach 1220 ms, innerhalb der Grenze, die für jeden Auftritt gilt (e2e/web.spec.ts).
   */
  .portrait[data-enter='in'] .portrait-corner-tl {
    --from: -0.875rem -0.875rem;

    animation-delay: 420ms;
  }

  .portrait[data-enter='in'] .portrait-corner-tr {
    --from: 0.875rem -0.875rem;

    animation-delay: 420ms;
  }

  .portrait[data-enter='in'] .portrait-corner-bl {
    --from: -0.875rem 0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-br {
    --from: 0.875rem 0.875rem;
  }

  /*
   * Die Linie beginnt oben, sobald das Foto dort ankommt. --dur-4 statt --dur-5: Mit 450 ms Vorlauf
   * endet sie nach 1250 ms, innerhalb der Grenze, die für jeden Auftritt gilt (e2e/web.spec.ts).
   */
  .portrait[data-enter='in'] .portrait-frame::after {
    animation: about-scan var(--dur-4) var(--ease-in-out) 450ms;
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes about-focus {
    from {
      opacity: 0;
      translate: var(--from);
    }
  }

  /* Die Linie läuft einmal von oben nach unten und verblasst auf den letzten 15 %. */
  @keyframes about-scan {
    0% {
      opacity: 1;
      transform: translateY(-100%);
    }

    85% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  /* Im Druck und bei angehaltener Bewegung wartet nichts auf seinen Auftritt. */
  @media print {
    .portrait[data-enter] * {
      opacity: 1;
    }
  }

  :global(html[data-motion='off']) .portrait[data-enter] * {
    opacity: 1;
    animation: none;
  }

  /* Die Linie ist ein Pseudo-Element (der Stern oben trifft sie nicht): angehalten bleibt sie weg. */
  :global(html[data-motion='off']) .portrait-frame::after {
    animation: none;
  }

  /* ---------- Firmengeschichte ---------- */

  /* ---------- Unser Team ---------- */

  .team {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .team-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }

  .member {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.25rem;
  }

  .member-photo {
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 5rem + 4vw, 8rem);
    aspect-ratio: 1;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--leaf-edge),
      0 0 0 0.375rem rgb(var(--leaf-rgb) / 0.12);
  }

  .member-photo :global(picture),
  .member-photo :global(.member-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .member-photo :global(.member-img) {
    border-radius: 50%;
    object-fit: cover;
  }

  /* Ohne Foto: die Initialen auf Salbei, ruhig und ohne Platzhalterbild. */
  .member-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: var(--sage);
    color: var(--moss);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .member-name {
    color: var(--charcoal);
    font-size: var(--fs-h4);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .member-role {
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  /*
   * Auftritt: Jedes Foto öffnet sich aus der Mitte wie die Blende im Hero (Clip und Zoom auf dem
   * Bild), im Abstand --stagger; die Initialen setzen sich aus einem leichten Zoom. Namen und
   * Aufgaben stehen vom ersten Bild an da (Text blendet nicht ein). Endet nach 800 ms plus drei
   * Versätzen, innerhalb der Grenze für jeden Auftritt.
   */
  .team-list[data-enter='wait'] .member-photo > * {
    opacity: 0;
  }

  .team-list[data-enter='in'] .member-photo > * {
    animation: member-open var(--dur-4) var(--ease-out) backwards;
  }

  .team-list[data-enter='in'] .member:nth-child(2) .member-photo > * {
    animation-delay: var(--stagger);
  }

  .team-list[data-enter='in'] .member:nth-child(3) .member-photo > * {
    animation-delay: calc(2 * var(--stagger));
  }

  .team-list[data-enter='in'] .member:nth-child(4) .member-photo > * {
    animation-delay: calc(3 * var(--stagger));
  }

  @keyframes member-open {
    from {
      clip-path: circle(30% at 50% 50%);
      transform: scale(1.1);
    }

    to {
      clip-path: circle(50% at 50% 50%);
    }
  }

  :global(html[data-motion='off']) .team-list[data-enter] .member-photo > * {
    opacity: 1;
    animation: none;
  }

  @media print {
    .team-list[data-enter] .member-photo > * {
      opacity: 1;
    }
  }

  @media (min-width: 48rem) {
    .team-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .history {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .timeline {
    display: grid;
    gap: 2rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--border-strong);
  }

  .moment {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  /* Punkt auf der Linie */
  .moment::before {
    position: absolute;
    top: 0.75rem;
    left: calc(-1.75rem - 6px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--leaf-edge);
    border-radius: 50%;
    background-color: var(--leaf);
    content: '';
  }

  .moment-year {
    color: var(--charcoal);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: var(--fw-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-display);
    line-height: 1;
  }

  .moment-body {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    max-width: 30em;
    color: var(--fg-muted);
  }

  .moment-body :global(.moment-photo) {
    display: block;
    width: 7.5rem;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-input);
    filter: sepia(0.15);
  }

  .moment-panel {
    display: grid;
    gap: 0.75rem;
  }

  /* Nur mit Skript: die grosse Jahreszahl, die Achse und «Weiter» */
  .yr-big,
  .yr-track {
    display: none;
  }

  /*
   * ---------- «Jahr für Jahr» (choice.ts setzt data-ready) ----------
   * Zeile 1: die Achse mit den sechs Jahren (Knöpfe), Zeile 2: ein Moment, Zeile 3: «Weiter». Alle
   * Momente liegen per Subgrid in derselben Zelle: Sie ist so hoch wie der längste, beim Wechsel
   * springt nichts. Eine grüne Linie wächst von 1946 bis zum gewählten Jahr (nur transform).
   */
  .years[data-ready] {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
  }

  .years[data-ready] .timeline,
  .years[data-ready] .moment {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / 3;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    gap: 0;
    padding: 0;
    border: 0;
  }

  .years[data-ready] .moment {
    pointer-events: none;
  }

  .years[data-ready] .moment > * {
    pointer-events: auto;
  }

  .years[data-ready] .moment::before {
    display: none;
  }

