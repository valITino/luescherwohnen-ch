---
/**
 * 06 Über uns: Porträt im Sucher-Rahmen, daneben Überschrift, Haltung und «Wir stehen für»
 * (an der Stelle des Terminals bei PSYber). Darunter die Firmengeschichte als Zeitleiste und die
 * beiden Standorte.
 * Texte und Jahreszahlen: «Unternehmen», «Firmengeschichte», «Firmenstandorte» der bisherigen
 * Website (docs/Homepage.docx). Widersprüchliche Angaben (Generation, Funktion) bleiben weg.
 */
import { Picture } from 'astro:assets';
import Icon from '@luescher/ui/components/Icon.astro';
import bruno from '../../assets/photos/portrait-bruno-laengle.jpg';
import hans from '../../assets/photos/portrait-hans-luescher.jpg';
import michael from '../../assets/photos/portrait-michael-laengle.jpg';
import { company } from '../../config/site.ts';
import SectionHead from '../SectionHead.astro';

const values = [
  'Erstklassige und nachhaltige Produkte, hinter denen wir hundertprozentig stehen können.',
  'Fachkompetenz, Inspiration, Ideen und eine kompetente, seriöse Beratung.',
  'Umfassende Dienstleistungen von der Planung bis hin zur Montage.',
  'Ein Umfeld, in dem Sie in Ruhe und ohne Zeitdruck Ihr Zuhause einrichten können.',
  'Qualitativ beste Arbeit, Pünktlichkeit und Zuverlässigkeit.',
];

const history = [
  {
    year: '1946',
    text: 'Die Brüder Hans und Arthur Lüscher gründen die Firma Wohnkonzeption Lüscher, ein Möbelgeschäft mit eigener Polsterwerkstätte.',
    photo: { src: hans, alt: 'Hans Lüscher, historisches Zeitungsporträt' },
  },
  {
    year: '1949',
    text: 'Nach der Trennung der beiden Brüder führt Hans Lüscher die Firma allein weiter.',
  },
  {
    year: '1959',
    text: 'Bezug der Liegenschaft an der Weiten Gasse 9: Das Sortiment zeigt sich neu auf 6 Etagen und rund 1200 m². Sie ist bis heute der Hauptsitz.',
  },
  {
    year: '1983',
    text: 'Nach dem Tod von Hans Lüscher übernimmt Bruno Längle die Firma.',
    photo: { src: bruno, alt: 'Bruno Längle am Schreibtisch, historisches Zeitungsfoto' },
  },
  {
    year: '2010',
    text: 'Aus der Einzelfirma Wohnkonzeption Lüscher wird die Lüscher Wohnen AG, vollständig in Familienbesitz.',
  },
  {
    year: 'Heute',
    text: `${company.management} führt das Familienunternehmen.`,
  },
];

const locations = [
  {
    label: 'Ausstellung',
    icon: 'store',
    lines: [company.name, company.street, `${company.zip} ${company.city}`],
  },
  {
    label: 'Lager',
    icon: 'truck',
    lines: [company.name, 'Ringstrasse 13', '5432 Neuenhof'],
  },
] as const;
---

<section data-lazy class="sheet sheet-sage on-sage" id="ueber" aria-labelledby="ueber-title">
  <div class="wrap">
    <div class="about">
      <div class="portrait" data-enter>
        <figure class="portrait-frame">
          <span class="portrait-corner portrait-corner-tl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-tr" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-bl" aria-hidden="true"></span>
          <span class="portrait-corner portrait-corner-br" aria-hidden="true"></span>
          <Picture
            src={michael}
            formats={['avif', 'webp']}
            widths={[400, 800]}
            sizes="(min-width: 56rem) 34rem, 100vw"
            alt={`Porträt von ${company.management} vor Vorhangstoff-Mustern`}
            class="portrait-photo"
            loading="lazy"
          />
          <figcaption class="portrait-caption">
            <span class="label-up">{company.management}</span>
            <span>Geschäftsleiter</span>
          </figcaption>
        </figure>
      </div>

      <div class="about-main">
        <SectionHead
          num="06"
          kicker="Über uns"
          title={'Ein Familien\u00ADunternehmen aus Baden.'}
          id="ueber-title"
        />

        <div class="about-text">
          <p class="lead">
            Seit 1946 richten wir Wohnungen und Häuser ein. Für uns steht der persönliche Kontakt
            und Ihre Bedürfnisse im Vordergrund.
          </p>
          <p>
            Unsere Grösse und unsere Lage fernab der Grossstadthektik geben uns die Möglichkeit,
            Ihnen die Zeit und Aufmerksamkeit zu schenken, die es braucht, um das für Sie richtige
            Produkt zu finden. Bei uns im Laden oder bei Ihnen zu Hause, zu dem für Sie besten
            Zeitpunkt.
          </p>
        </div>

        <div class="card values" data-enter>
          <p class="kicker values-kicker">Wir stehen für</p>
          <ul class="values-list">
            {values.map((value) => (
              <li>
                <Icon name="check" size={20} />
                <span>{value}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="history">
      <h3 class="display h3 history-title">Firmengeschichte</h3>
      <ol class="timeline">
        {history.map((entry) => (
          <li class="moment">
            <span class="moment-year">{entry.year}</span>
            <div class="moment-body">
              {entry.photo && (
                <Picture
                  src={entry.photo.src}
                  formats={['avif', 'webp']}
                  widths={[160, 320]}
                  sizes="10rem"
                  alt={entry.photo.alt}
                  class="moment-photo"
                  loading="lazy"
                />
              )}
              <p>{entry.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <ul class="locations">
      {locations.map((location) => (
        <li class="card location">
          <p class="label-up location-label">
            <Icon name={location.icon} size={18} />
            {location.label}
          </p>
          <address class="location-address">
            {location.lines.map((line) => (
              <span>{line}</span>
            ))}
          </address>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .about-main {
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .about-text {
    display: grid;
    gap: 1rem;
    max-width: 38em;
  }

  .about-text p:not(.lead) {
    color: var(--fg-muted);
  }

  /* ---------- Porträt im Sucher ---------- */

  .portrait {
    position: relative;
  }

  .portrait-frame {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
    height: 100%;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-panel);
    background-color: var(--paper);
  }

  .portrait-frame :global(.portrait-photo) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(20rem, 60vw, 36rem);
    max-height: 44rem;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .portrait-caption {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem 1.5rem;
    color: var(--ash);
    font-size: var(--fs-small);
  }

  .portrait-caption .label-up {
    color: var(--charcoal);
  }

  /* Die Ecken liegen wie ein Sucher über dem Bild. */
  .portrait-corner {
    position: absolute;
    z-index: 1;
    width: 1.125rem;
    height: 1.125rem;
    border: 1.5px solid rgb(var(--paper-rgb) / 0.95);
  }

  .portrait-corner-tl {
    top: 1.25rem;
    left: 1.25rem;
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner-tr {
    top: 1.25rem;
    right: 1.25rem;
    border-bottom: 0;
    border-left: 0;
  }

  .portrait-corner-bl {
    bottom: 6.25rem;
    left: 1.25rem;
    border-top: 0;
    border-right: 0;
  }

  .portrait-corner-br {
    right: 1.25rem;
    bottom: 6.25rem;
    border-top: 0;
    border-left: 0;
  }

  /* ---------- Wir stehen für ---------- */

  .values {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .values-list {
    display: grid;
    gap: 0.875rem;
  }

  .values-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
  }

  .values-list :global(.icon) {
    margin-top: 0.15em;
    color: var(--leaf-deep);
  }

  /*
   * Auftritt, sobald die Sektion ins Bild kommt (reveal.ts setzt data-enter): Der Sucher stellt
   * scharf (die Ecken rücken an ihren Platz), eine feine grüne Linie tastet das Bild einmal ab;
   * die Werte erscheinen nacheinander.
   */
  .portrait-frame::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(
      to bottom,
      rgb(var(--leaf-rgb) / 0) 0,
      rgb(var(--leaf-rgb) / 0.85) 50%,
      rgb(var(--leaf-rgb) / 0) 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 0.375rem;
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .portrait[data-enter='wait'] .portrait-frame :global(.portrait-photo),
  .portrait[data-enter='wait'] .portrait-corner,
  .portrait[data-enter='wait'] .portrait-caption,
  .values[data-enter='wait'] .values-list li {
    opacity: 0;
  }

  .portrait[data-enter='in'] .portrait-frame :global(.portrait-photo) {
    animation: about-rise 700ms var(--ease) backwards;
  }

  .portrait[data-enter='in'] .portrait-caption {
    animation: about-rise 500ms var(--ease) 260ms backwards;
  }

  .portrait[data-enter='in'] .portrait-corner {
    animation: about-focus 560ms cubic-bezier(0.2, 1.5, 0.4, 1) 140ms backwards;
  }

  .portrait[data-enter='in'] .portrait-corner-tl {
    --from: -0.875rem -0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-tr {
    --from: 0.875rem -0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-bl {
    --from: -0.875rem 0.875rem;
  }

  .portrait[data-enter='in'] .portrait-corner-br {
    --from: 0.875rem 0.875rem;
  }

  .portrait[data-enter='in'] .portrait-frame::after {
    animation: about-scan 950ms cubic-bezier(0.3, 0, 0.3, 1) 320ms;
  }

  .values[data-enter='in'] .values-list li {
    animation: about-line 320ms var(--ease) backwards;
  }

  .values[data-enter='in'] .values-list li:nth-child(2) {
    animation-delay: 120ms;
  }

  .values[data-enter='in'] .values-list li:nth-child(3) {
    animation-delay: 240ms;
  }

  .values[data-enter='in'] .values-list li:nth-child(4) {
    animation-delay: 360ms;
  }

  .values[data-enter='in'] .values-list li:nth-child(5) {
    animation-delay: 480ms;
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes about-focus {
    from {
      opacity: 0;
      translate: var(--from);
    }
  }

  @keyframes about-scan {
    0% {
      background-position: 0 0;
      opacity: 1;
    }

    85% {
      opacity: 1;
    }

    100% {
      background-position: 0 100%;
      opacity: 0;
    }
  }

  @keyframes about-line {
    from {
      opacity: 0;
      transform: translateY(0.375rem);
    }
  }

  /* Im Druck und bei angehaltener Bewegung wartet nichts auf seinen Auftritt. */
  @media print {
    .portrait[data-enter] *,
    .values[data-enter] * {
      opacity: 1;
    }
  }

  :global(html[data-motion='off']) .portrait[data-enter] *,
  :global(html[data-motion='off']) .values[data-enter] * {
    opacity: 1;
    animation: none;
  }

  /* ---------- Firmengeschichte ---------- */

  .history {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  .timeline {
    display: grid;
    gap: 2rem;
    padding-left: 1.75rem;
    border-left: 1px solid var(--border-strong);
  }

  .moment {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  /* Punkt auf der Linie */
  .moment::before {
    position: absolute;
    top: 0.75rem;
    left: calc(-1.75rem - 6px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--leaf-edge);
    border-radius: 50%;
    background-color: var(--leaf);
    content: '';
  }

  .moment-year {
    color: var(--charcoal);
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    font-weight: var(--fw-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--ls-display);
    line-height: 1;
  }

  .moment-body {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    max-width: 30em;
    color: var(--fg-muted);
  }

  .moment-body :global(.moment-photo) {
    display: block;
    width: 7.5rem;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-input);
    filter: sepia(0.15);
  }

  /* ---------- Standorte ---------- */

  .locations {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .location {
    display: grid;
    gap: 0.875rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .location-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .location-label :global(.icon) {
    color: var(--leaf-deep);
  }

  .location-address {
    display: grid;
    color: var(--charcoal);
    font-size: var(--fs-h4);
    font-style: normal;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  @media (min-width: 40rem) {
    .locations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: stretch;
    }
  }

  @media (min-width: 64rem) {
    .history {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      align-items: start;
    }

    /* Waagrecht: drei Momente pro Reihe, die Linie oben */
    .timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3rem 2.5rem;
      padding-left: 0;
      border-left: 0;
    }

    .moment {
      padding-top: 1.75rem;
      border-top: 1px solid var(--border-strong);
    }

    .moment::before {
      top: -6px;
      left: 0;
    }
  }
</style>
