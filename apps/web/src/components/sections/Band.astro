---
/**
 * Band: zwei gegenläufige Reihen grosser Wörter quer über die Seite, eine ruhige Textur zwischen
 * Sortiment und Haltung (Entscheid 45: ohne eigene Überschrift und ohne Etiketten, die Wörter
 * genügen). CSS-Animation über transform; die Kopie für den Loop ist aria-hidden.
 * Pausiert bei Hover, bei Fokus und über den runden Knopf. Reduced motion: statisch, umbrechend.
 * Begriffe aus der Angebotsliste der bisherigen Website (docs/Homepage.docx).
 */
import Icon from '@luescher/ui/components/Icon.astro';

const rows = [
  [
    'Möbel',
    'Polstermöbel',
    'Esstische und Stühle',
    'Betten und Bettwaren',
    'Teppiche',
    'Vorhänge und Vorhangsysteme',
    'Lampen und Beleuchtung',
  ],
  [
    'Parkett',
    'Laminat',
    'Kork',
    'Innenarchitektur',
    'Bauführung',
    'Beratung bei Ihnen zu Hause',
    'Lieferung und Montage',
  ],
];
---

<section data-lazy class="sheet ticker" aria-label="Sortiment und Service" data-ticker>
  <div class="ticker-rows">
    {rows.map((row, rowIndex) => (
      <div class:list={['ticker-row', { 'ticker-row-reverse': rowIndex === 1 }]}>
        <ul class="ticker-list">
          {row.map((name) => (
            <li class="pill">{name}</li>
          ))}
        </ul>
        <ul class="ticker-list ticker-copy" aria-hidden="true">
          {row.map((name) => (
            <li class="pill">{name}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="wrap ticker-foot">
    {/* Der Name sagt, was der Button tut; er wechselt mit dem Zustand (darum kein aria-pressed). */}
    <button type="button" class="ticker-toggle" data-ticker-toggle>
      <span class="ticker-icon ticker-icon-pause">
        <Icon name="pause" size={16} />
      </span>
      <span class="ticker-icon ticker-icon-play">
        <Icon name="play" size={16} />
      </span>
      <span class="sr-only" data-ticker-label>
        Band anhalten
      </span>
    </button>
  </div>
</section>

<style>
  .ticker {
    overflow: clip;
  }

  .ticker-foot {
    display: flex;
    justify-content: end;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  /* Rund, nur das Symbol: Der Name (Band anhalten, Band fortsetzen) bleibt für Screenreader. */
  .ticker-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--fg-strong);
    transition: border-color var(--dur-2) var(--ease);
  }

  .ticker-toggle:hover {
    border-color: var(--leaf-deep);
  }

  .ticker-icon {
    display: grid;
  }

  .ticker-icon-play,
  .ticker:global(.is-paused) .ticker-icon-pause {
    display: none;
  }

  .ticker:global(.is-paused) .ticker-icon-play {
    display: grid;
  }

  /* Die Enden laufen weich aus (statisch, nur eine Maske). */
  .ticker-rows {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker-row {
    display: flex;
    width: max-content;
    animation: ticker 60s linear infinite;
  }

  .ticker-row-reverse {
    animation-direction: reverse;
    animation-duration: 68s;
  }

  .ticker-list {
    display: flex;
    flex: none;
  }

  /* Ein Wort, davor ein kleiner grüner Punkt als Trenner (auch über die Naht des Loops). */
  .pill {
    display: inline-flex;
    align-items: center;
    color: var(--charcoal);
    font-size: clamp(1.75rem, 1rem + 3.2vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .pill::before {
    width: 0.5rem;
    height: 0.5rem;
    margin-inline: clamp(1.25rem, 2.5vw, 2.5rem);
    border-radius: 50%;
    background-color: var(--leaf);
    content: '';
  }

  .ticker-row-reverse .pill {
    color: var(--ash);
  }

  /*
   * Pausiert bei Hover, bei Fokus im Band und wenn der Button es anhält. Der Fokus auf dem Button
   * selbst zählt nicht: Sonst stünde das Band nach «Band fortsetzen» weiter still.
   */
  .ticker:global(.is-paused) .ticker-row,
  .ticker-rows:focus-within .ticker-row {
    animation-play-state: paused;
  }

  @media (hover: hover) {
    .ticker-rows:hover .ticker-row {
      animation-play-state: paused;
    }
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /*
   * Reduzierte Bewegung oder kein Skript (dann gäbe es keinen Knopf zum Anhalten, WCAG 2.2.2):
   * statisch, umbrechend, mittig, etwas kleiner.
   */
  @media (prefers-reduced-motion: reduce), (scripting: none) {
    /* Block statt Flex: Sonst behält die Liste ihre volle Breite und bricht nicht um. */
    .ticker-row {
      display: block;
      width: auto;
      animation: none;
    }

    .ticker-rows {
      width: min(100% - 2 * var(--gutter), var(--container));
      margin-inline: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .ticker-list {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 1.5rem;
    }

    .pill {
      font-size: var(--fs-h3);
      white-space: normal;
      text-wrap: balance;
    }

    .pill::before {
      display: none;
    }

    .ticker-copy,
    .ticker-foot {
      display: none;
    }
  }
</style>
