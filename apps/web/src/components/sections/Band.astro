---
/**
 * Band: zwei gegenläufige Reihen grosser Wörter quer über die Seite, eine ruhige Textur zwischen
 * Sortiment und Haltung (Entscheid 45: ohne eigene Überschrift und ohne Etiketten, die Wörter
 * genügen). Die Reihen laufen nicht von selbst: Sie ziehen mit dem Scrollen, die obere nach
 * links, die untere nach rechts (scroll.css). Wer nicht scrollt, sieht nichts sich bewegen;
 * darum braucht das Band keinen Knopf zum Anhalten. Die zweite Fassung jeder Reihe füllt nur
 * die Breite und ist aria-hidden.
 * Ohne Unterstützung für scrollgekoppelte Animationen und bei reduzierter Bewegung: statisch,
 * umbrechend, alle Wörter sichtbar.
 * Begriffe aus der Angebotsliste der bisherigen Website (docs/Homepage.docx).
 */

const rows = [
  [
    'Möbel',
    'Polstermöbel',
    'Esstische und Stühle',
    'Betten und Bettwaren',
    'Teppiche',
    'Vorhänge und Vorhangsysteme',
    'Lampen und Beleuchtung',
  ],
  [
    'Parkett',
    'Laminat',
    'Kork',
    'Innenarchitektur',
    'Bauführung',
    'Beratung bei Ihnen zu Hause',
    'Lieferung und Montage',
  ],
];
---

<section data-lazy class="sheet ticker" aria-label="Sortiment und Service" data-ticker>
  <div class="ticker-rows">
    {rows.map((row, rowIndex) => (
      <div class:list={['ticker-row', { 'ticker-row-reverse': rowIndex === 1 }]}>
        <ul class="ticker-list">
          {row.map((name) => (
            <li class="pill">{name}</li>
          ))}
        </ul>
        <ul class="ticker-list ticker-copy" aria-hidden="true">
          {row.map((name) => (
            <li class="pill">{name}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  /*
   * Grundform ohne Bewegung: eine ruhige, umbrechende Liste, alle Wörter sichtbar. So steht das
   * Band ohne Unterstützung für scrollgekoppelte Animationen, bei reduzierter Bewegung und im
   * Druck.
   */
  /*
   * Das Band ist ein schmaler Streifen: Es zieht ganz durch und bleibt nicht unter dem nächsten
   * Bogen zurück (scroll.css, --sc-leave). Sonst wäre es am Handy schon halb verdeckt, während
   * es noch mitten im Bild steht.
   */
  .ticker {
    --sc-leave: 0;

    overflow: clip;
  }

  .ticker-rows {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }

  .ticker-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1.5rem;
  }

  .ticker-copy {
    display: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    color: var(--charcoal);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .ticker-row-reverse .pill {
    color: var(--ash);
  }

  /*
   * Mit scrollgekoppelter Bewegung: zwei lange Reihen quer über die Seite, die Enden laufen weich
   * aus (statische Maske). Die Bewegung selbst steht in scroll.css. Hält jemand die Bewegung an
   * (Schalter), bleiben die Reihen stehen, wie sie ohne Bewegung liegen: Die Seite wird dabei
   * nicht länger oder kürzer.
   */
  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      .ticker-rows {
        width: auto;
        margin-inline: 0;
        -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
        mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
      }

      .ticker-row {
        display: flex;
        width: max-content;
      }

      .ticker-list {
        flex: none;
        flex-wrap: nowrap;
        justify-content: start;
        gap: 0;
      }

      .ticker-copy {
        display: flex;
      }

      /* Ein Wort, davor ein kleiner grüner Punkt als Trenner (auch über die Naht der Reihe). */
      .pill {
        font-size: clamp(1.75rem, 1rem + 3.2vw, 4rem);
        white-space: nowrap;
      }

      .pill::before {
        width: 0.5rem;
        height: 0.5rem;
        margin-inline: clamp(1.25rem, 2.5vw, 2.5rem);
        border-radius: 50%;
        background-color: var(--leaf);
        content: '';
      }
    }
  }
</style>
