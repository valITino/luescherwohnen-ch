---
/**
 * 01 Sortiment: sieben Bereiche «Raum für Raum» auf grünlichem Bogen: ein Index der Bereiche und
 * eine Bühne, die jeweils ein Foto mit seinem Text zeigt (choice.ts). Ohne Skript eine Liste.
 * Bereiche nach Briefing (WEB-F-002) und der Angebotsliste der bisherigen Website; die kurzen
 * Texte stammen aus «Unternehmen» und «Unsere Kompetenzen» (docs/Homepage.docx).
 * Bilder: eigene Referenzfotos, wo es welche gibt, sonst Herstellerbilder (Rechte: D-005).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@luescher/ui/components/Icon.astro';
import betten from '../../assets/photos/sortiment-betten.jpg';
import boden from '../../assets/photos/sortiment-boden.jpg';
import leuchten from '../../assets/photos/sortiment-leuchten.jpg';
import moebel from '../../assets/photos/sortiment-moebel.jpg';
import polster from '../../assets/photos/sortiment-polstermoebel.jpg';
import teppiche from '../../assets/photos/sortiment-teppiche.jpg';
import vorhaenge from '../../assets/photos/sortiment-vorhaenge.jpg';
import SectionHead from '../SectionHead.astro';

interface Area {
  title: string;
  /** Marke für Direktlinks (#raum-betten) */
  slug: string;
  /** Name mit weichen Trennstrichen für schmale Bildschirme (nur Anzeige) */
  display?: string;
  text: string;
  image: ImageMetadata;
  alt: string;
}

const areas: Area[] = [
  {
    title: 'Möbel',
    slug: 'moebel',
    text: 'Für vielfältige Wohn- und Essräume: Esstische und Stühle, Schränke und Bürolösungen.',
    image: moebel,
    alt: 'Esstisch aus Holz mit grauen Schalenstühlen und Pendelleuchte',
  },
  {
    title: 'Polstermöbel',
    slug: 'polstermoebel',
    display: 'Polster\u00ADmöbel',
    text: 'Sofas und Sessel, die zu Ihnen und Ihrem Raum passen.',
    image: polster,
    alt: 'Hellgraues Ecksofa mit Kissen und Wolldecke',
  },
  {
    title: 'Betten und Bettwaren',
    slug: 'betten',
    display: 'Betten und Bett\u00ADwaren',
    text: 'Komfortable Schlafzimmereinrichtungen, Betten und Bettinhalte.',
    image: betten,
    alt: 'Schlafzimmer unter dem Dach mit Bett und Einbauschrank',
  },
  {
    title: 'Bodenbeläge',
    slug: 'bodenbelaege',
    display: 'Boden\u00ADbeläge',
    text: 'Bodenbeläge aller Art: Teppich, Parkett, Laminat, Novilon, Vinyl, Kork und mehr.',
    image: boden,
    alt: 'Treppe mit neuem grauem Teppichbelag',
  },
  {
    title: 'Teppiche',
    slug: 'teppiche',
    text: 'Teppiche und Heimtextilien für jeden Raum.',
    image: teppiche,
    alt: 'Graues Ecksofa mit buntem Patchwork-Teppich',
  },
  {
    title: 'Vorhänge',
    slug: 'vorhaenge',
    text: 'Vorhänge sowie Vorhang- und Beschattungssysteme.',
    image: vorhaenge,
    alt: 'Essbereich mit hellen, floral bedruckten Vorhängen',
  },
  {
    title: 'Lampen und Beleuchtung',
    slug: 'lampen',
    display: 'Lampen und Be\u00ADleuchtung',
    text: 'Lampen und Beleuchtungssysteme für Wohnen und Arbeiten.',
    image: leuchten,
    alt: 'Mehrere farbige Tischleuchten',
  },
];

const pad = (index: number) => String(index + 1).padStart(2, '0');
const total = pad(areas.length - 1);
---

<section
  data-lazy
  class="sheet sheet-sage on-sage"
  id="sortiment"
  aria-labelledby="sortiment-title"
>
  <div class="wrap">
    <SectionHead
      num="01"
      kicker="Sortiment"
      title="Alles für Ihr Zuhause."
      id="sortiment-title"
      layout="split"
      lead="Unser Angebot deckt alle Bereiche der Inneneinrichtung ab. Am schönsten sehen Sie es bei uns in der Ausstellung: anschauen, berühren, Probe sitzen."
    />

    {/*
      «Raum für Raum» (choice.ts): ein Index der Bereiche und eine Bühne mit einem Foto. Ohne
      Skript dieselben Bereiche als Liste mit Foto und Text. Alle Texte und Bilder stehen im HTML.
    */}
    <div class="rooms-frame">
      <div class="rooms" data-rooms>
        <ol class="room-list">
          {areas.map((area, index) => (
            <li
              class="room"
              id={`raum-${area.slug}`}
              data-choice-item
              data-choice-name={area.title}
            >
              <h3 class="room-head" data-choice-head data-choice-button="room-btn">
                <span class="secnum room-num" aria-hidden="true">
                  {pad(index)}
                </span>
                <span class="room-name">{area.display ?? area.title}</span>
                <span class="room-arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={18} />
                </span>
              </h3>
              <figure class="room-panel" id={`raum-${area.slug}-tafel`} data-choice-panel>
                {/* Nur das erste Foto tritt beim Hereinscrollen auf (reveal.ts), die anderen
                    erst, wenn man sie wählt. */}
                <div
                  class:list={['room-media', { 'enter-unveil': index === 0 }]}
                  data-enter={index === 0 ? '' : undefined}
                >
                  <Picture
                    src={area.image}
                    formats={['avif', 'webp']}
                    widths={[480, 800, 1000]}
                    sizes="(min-width: 80rem) 46rem, (min-width: 54rem) 55vw, 92vw"
                    alt={area.alt}
                    class="room-photo"
                    loading="lazy"
                  />
                </div>
                <figcaption class="room-text">
                  <span class="secnum" aria-hidden="true">
                    {pad(index)} / {total}
                  </span>
                  <span>{area.text}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ol>
        <button type="button" class="room-next" data-choice-next hidden>
          <span data-choice-next-text>Nächster Raum</span>
          <span class="room-next-icon" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Ohne Skript: eine ruhige Liste (Foto, Name, Text) ---------- */

  .rooms-frame {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    /* Zwei Spalten erst, wenn der Platz in rem reicht: Bei 200 % Text bleibt es eine. */
    container-type: inline-size;
  }

  .room-list {
    display: grid;
    gap: 2rem 1.25rem;
  }

  .room-head {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    margin-bottom: 0.75rem;
    font-size: var(--fs-h4);
    font-weight: 650;
    letter-spacing: var(--ls-heading);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .room-num {
    flex: none;
  }

  .room-name {
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .room-arrow,
  .room-next {
    display: none;
  }

  .room-panel {
    display: grid;
    align-content: start;
    gap: 0.875rem;
    margin: 0;
  }

  .room-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--r-panel);
    background-color: var(--sand);
  }

  .room-media :global(picture),
  .room-media :global(.room-photo) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .room-media :global(.room-photo) {
    object-fit: cover;
  }

  .room-text {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    max-width: 34em;
    color: var(--charcoal);
  }

  .room-text .secnum {
    color: var(--leaf-deep);
  }

  @container (min-width: 40rem) {
    .rooms:not([data-ready]) .room-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
   * ---------- Mit Skript: Index und Bühne (choice.ts setzt data-ready) ----------
   * Ein Raster: auf dem Handy Zeile 1 die Bühne, darunter die sieben Namen; am Desktop links die
   * Namen, rechts die Bühne über alle Zeilen. Jede <li> liegt per Subgrid über dem ganzen
   * Raster, so steht jede Überschrift im HTML direkt vor ihrem Text, und alle Tafeln liegen in
   * derselben Zelle: Die Bühne ist so hoch wie die höchste Tafel, beim Wechsel springt nichts.
   */
  .rooms[data-ready] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto repeat(7, auto);
  }

  .rooms[data-ready] .room-list,
  .rooms[data-ready] .room {
    display: grid;
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
  }

  /* Die <li> liegen übereinander: Nur ihre Inhalte nehmen den Zeiger an. */
  .rooms[data-ready] .room {
    pointer-events: none;
  }

  .rooms[data-ready] .room > * {
    pointer-events: auto;
  }

  .rooms[data-ready] .room:nth-child(1) .room-head {
    grid-row: 2;
  }

  .rooms[data-ready] .room:nth-child(2) .room-head {
    grid-row: 3;
  }

  .rooms[data-ready] .room:nth-child(3) .room-head {
    grid-row: 4;
  }

  .rooms[data-ready] .room:nth-child(4) .room-head {
    grid-row: 5;
  }

  .rooms[data-ready] .room:nth-child(5) .room-head {
    grid-row: 6;
  }

  .rooms[data-ready] .room:nth-child(6) .room-head {
    grid-row: 7;
  }

  .rooms[data-ready] .room:nth-child(7) .room-head {
    grid-row: 8;
  }

  .rooms[data-ready] .room-head {
    display: block;
    grid-column: 1;
    margin: 0;
    font-size: inherit;
  }

  /* Der Knopf entsteht im Skript (choice.ts), darum :global. */
  .room-head :global(.room-btn) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.875rem;
    width: 100%;
    min-height: 3.5rem;
    padding-block: 0.375rem;
    border-bottom: 1px solid rgb(var(--charcoal-rgb) / 0.14);
    border-radius: 0.25rem;
    color: var(--moss);
    text-align: left;
    cursor: pointer;
  }

  .room:first-child .room-head :global(.room-btn) {
    border-top: 1px solid rgb(var(--charcoal-rgb) / 0.14);
  }

  .rooms[data-ready] .room-name {
    font-size: clamp(1.0625rem, 0.9rem + 1.1vw, 2.125rem);
    font-weight: 650;
    letter-spacing: var(--ls-heading);
    line-height: 1.02;
    text-transform: uppercase;
    transition:
      color var(--dur-2) var(--ease),
      transform var(--dur-3) var(--ease-out);
  }

  .room-head :global(.room-btn) .secnum {
    color: var(--moss);
    transition: color var(--dur-2) var(--ease);
  }

  .room-arrow {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--steel);
    border-radius: 50%;
    color: var(--charcoal);
    transition:
      background-color var(--dur-2) var(--ease),
      border-color var(--dur-2) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .room-head :global(.room-btn:hover) .room-name {
      color: var(--charcoal);
    }
  }

  /* Der gewählte Raum: Name dunkel und einen Hauch eingerückt, Nummer grün, Pfeil gefüllt. */
  .room[data-on] .room-head :global(.room-btn) .secnum {
    color: var(--leaf-deep);
  }

  .room[data-on] .room-name {
    color: var(--charcoal);
    transform: translateX(0.375rem);
  }

  .room[data-on] .room-arrow {
    border-color: var(--leaf-edge);
    background-color: var(--leaf);
    color: var(--ink);
  }

  /* ---------- Bühne ---------- */

  .rooms[data-ready] .room-panel {
    position: relative;
    grid-column: 1;
    grid-row: 1;
    margin-bottom: 1.5rem;
    visibility: hidden;
  }

  .room[data-on] .room-panel,
  .room[data-leaving] .room-panel {
    visibility: visible;
  }

  /* Beim Wechsel geht nur der alte Text sofort; sein Foto bleibt, bis das neue es deckt. */
  .room[data-leaving] .room-text {
    visibility: hidden;
  }

  .room[data-anim] .room-media {
    background-color: transparent;
  }

  /* Das neue Foto steigt über das alte, in der Sprache der Bild-Enthüllung (components.css). */
  .room[data-on][data-anim] .room-media :global(.room-photo) {
    animation: unveil var(--dur-4) var(--ease-expo) both;
  }

  /* Der Text ist ab dem ersten Bild lesbar und rückt nur einen Hauch nach. */
  .room[data-on][data-anim] .room-text {
    animation: room-text var(--dur-3) var(--ease-out) both;
  }

  @keyframes room-text {
    from {
      transform: translateY(0.25rem);
    }
  }

  /* «Nächster Raum»: liegt über allen Tafeln und bleibt beim Wechsel stehen (der Fokus auch). */
  .rooms[data-ready] .room-next:not([hidden]) {
    position: relative;
    z-index: 20;
    display: inline-flex;
    grid-column: 1;
    grid-row: 1;
    align-items: center;
    align-self: start;
    justify-self: end;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin: 0.75rem;
    padding: 0 0.4375rem 0 1rem;
    border: 1px solid var(--steel);
    border-radius: var(--r-pill);
    background-color: var(--paper);
    color: var(--charcoal);
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease);
  }

  .room-next-icon {
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background-color: var(--leaf);
    color: var(--ink);
    transition: transform var(--dur-2) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .room-next:hover {
      border-color: var(--leaf-deep);
    }

    .room-next:hover .room-next-icon {
      transform: translateX(2px);
    }
  }

  @container (min-width: 30rem) {
    .room-head :global(.room-btn) {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .rooms[data-ready] .room-arrow {
      display: grid;
    }
  }

  @container (min-width: 50rem) {
    .rooms[data-ready] {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: 1fr repeat(7, auto) 1fr;
      column-gap: clamp(2rem, 5vw, 5rem);
    }

    .room-head :global(.room-btn) {
      column-gap: 1.25rem;
      min-height: 4.25rem;
      padding-block: 0.625rem;
    }

    .rooms[data-ready] .room-panel {
      grid-column: 2;
      grid-row: 1 / -1;
      gap: 1.125rem;
      margin-bottom: 0;
    }

    .rooms[data-ready] .room-media {
      aspect-ratio: 16 / 10;
    }

    .rooms[data-ready] .room-next:not([hidden]) {
      grid-column: 2;
      grid-row: 1 / -1;
      margin: 1.25rem;
    }
  }

  /* Ohne Subgrid (ältere Browser): die Liste wie ohne Skript. */
  @supports not (grid-template-rows: subgrid) {
    .rooms[data-ready],
    .rooms[data-ready] .room-list,
    .rooms[data-ready] .room {
      display: block;
    }

    .rooms[data-ready] .room-panel {
      visibility: visible;
    }

    .rooms[data-ready] .room-next:not([hidden]) {
      display: none;
    }
  }

  /* Im Druck: alle Bereiche untereinander. */
  @media print {
    .rooms[data-ready],
    .rooms[data-ready] .room-list,
    .rooms[data-ready] .room {
      display: block;
    }

    .rooms[data-ready] .room-panel {
      visibility: visible;
    }
  }
</style>
