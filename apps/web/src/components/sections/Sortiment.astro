---
/**
 * 01 Sortiment: sieben Bereiche als Bildkarten auf grünlichem Bogen.
 * Bereiche nach Briefing (WEB-F-002) und der Angebotsliste der bisherigen Website; die kurzen
 * Texte stammen aus «Unternehmen» und «Unsere Kompetenzen» (docs/Homepage.docx).
 * Bilder: eigene Referenzfotos, wo es welche gibt, sonst Herstellerbilder (Rechte: D-005).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import betten from '../../assets/photos/sortiment-betten.jpg';
import boden from '../../assets/photos/sortiment-boden.jpg';
import leuchten from '../../assets/photos/sortiment-leuchten.jpg';
import moebel from '../../assets/photos/sortiment-moebel.jpg';
import polster from '../../assets/photos/sortiment-polstermoebel.jpg';
import teppiche from '../../assets/photos/sortiment-teppiche.jpg';
import vorhaenge from '../../assets/photos/sortiment-vorhaenge.jpg';
import SectionHead from '../SectionHead.astro';

interface Area {
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  wide?: boolean;
}

const areas: Area[] = [
  {
    title: 'Möbel',
    text: 'Für vielfältige Wohn- und Essräume: Esstische und Stühle, Schränke und Bürolösungen.',
    image: moebel,
    alt: 'Esstisch aus Holz mit grauen Schalenstühlen und Pendelleuchte',
    wide: true,
  },
  {
    title: 'Polstermöbel',
    text: 'Sofas und Sessel, die zu Ihnen und Ihrem Raum passen.',
    image: polster,
    alt: 'Hellgraues Ecksofa mit Kissen und Wolldecke',
  },
  {
    title: 'Betten und Bettwaren',
    text: 'Komfortable Schlafzimmereinrichtungen, Betten und Bettinhalte.',
    image: betten,
    alt: 'Schlafzimmer unter dem Dach mit Bett und Einbauschrank',
  },
  {
    title: 'Bodenbeläge',
    text: 'Bodenbeläge aller Art: Teppich, Parkett, Laminat, Novilon, Vinyl, Kork und mehr.',
    image: boden,
    alt: 'Treppe mit neuem grauem Teppichbelag',
  },
  {
    title: 'Teppiche',
    text: 'Teppiche und Heimtextilien für jeden Raum.',
    image: teppiche,
    alt: 'Graues Ecksofa mit buntem Patchwork-Teppich',
  },
  {
    title: 'Vorhänge',
    text: 'Vorhänge sowie Vorhang- und Beschattungssysteme.',
    image: vorhaenge,
    alt: 'Essbereich mit hellen, floral bedruckten Vorhängen',
  },
  {
    title: 'Lampen und Beleuchtung',
    text: 'Lampen und Beleuchtungssysteme für Wohnen und Arbeiten.',
    image: leuchten,
    alt: 'Mehrere farbige Tischleuchten',
    wide: true,
  },
];

const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<section
  data-lazy
  class="sheet sheet-sage on-sage"
  id="sortiment"
  aria-labelledby="sortiment-title"
>
  <div class="wrap">
    <SectionHead
      num="01"
      kicker="Sortiment"
      title="Alles für Ihr Zuhause."
      id="sortiment-title"
      layout="split"
      lead="Unser Angebot deckt alle Bereiche der Inneneinrichtung ab. Am schönsten sehen Sie es bei uns in der Ausstellung: anschauen, berühren, Probe sitzen."
    />

    <ul class="areas">
      {areas.map((area, index) => (
        <li class:list={['card card-hover area', { 'area-wide': area.wide }]}>
          <div class="area-media enter-unveil" data-enter>
            <Picture
              src={area.image}
              formats={['avif', 'webp']}
              widths={area.wide ? [480, 800, 1000] : [360, 600]}
              sizes={
                area.wide
                  ? '(min-width: 64rem) 52rem, (min-width: 40rem) 90vw, 100vw'
                  : '(min-width: 64rem) 26rem, (min-width: 40rem) 45vw, 100vw'
              }
              alt={area.alt}
              class="area-photo"
              loading="lazy"
            />
          </div>
          <div class="area-body">
            <p class="area-num">
              <span class="secnum" aria-hidden="true">
                {pad(index)}
              </span>
            </p>
            <h3 class="display h3 area-title">{area.title}</h3>
            <p class="area-text">{area.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .areas {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .area {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
  }

  .area-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    /* Sandfläche bis zum Bild: .enter-unveil in components.css */
  }

  .area-media :global(.area-photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Langsamer Zoom: ruhiger als ein kurzer Ruck */
    transition: transform 700ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .area:hover .area-media :global(.area-photo) {
      transform: scale(1.03);
    }
  }

  .area-body {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .area-num {
    line-height: 1;
  }

  /* minmax: Lange Wörter wie «Bodenbeläge» sollen die Karte nicht breiter machen. */
  .area-title {
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .area-text {
    max-width: 30em;
    color: var(--fg-muted);
  }

  @media (min-width: 40rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .area-wide:first-child {
      grid-column: span 2;
    }

    .area-wide:first-child .area-media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 64rem) {
    .areas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Breite Karten: Bild und Text nebeneinander wirken ruhiger als ein sehr flaches Bild. */
    .area-wide {
      grid-column: span 2;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-rows: none;
    }

    /* `:first-child` mitnennen: Die Regel ab 40rem ist sonst spezifischer und erzwingt 16:9,
       dann wird das Bild breiter als seine Spalte und liegt über dem Text. */
    .area-wide .area-media,
    .area-wide:first-child .area-media {
      aspect-ratio: auto;
      min-height: 22rem;
    }

    .area-wide .area-body {
      align-content: end;
    }
  }
</style>
