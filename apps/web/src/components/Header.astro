---
/**
 * Header in zwei Zuständen:
 *   oben:     Logo links, Navigation in der Mitte, CTA rechts (Mobile: Logo, Anrufen und «Menü»)
 *   gescrollt: schwebende Kapsel in der Mitte mit Logo, Anrufen, CTA und rundem Menü-Knopf
 * Das Vollbild-Menü hält den Fokus, Esc schliesst, die Beschriftung wechselt auf «Schliessen».
 * Bewegung: Die Leiste wird zur Kapsel, indem ihr Inhalt kurz abtaucht und die Glasfläche sich
 * danach aus der Mitte auffaltet. Das Menü rollt wie ein Vorhang aus, die grossen Wörter steigen
 * Zeile für Zeile aus ihrer Maske. Beides reines CSS, header.ts setzt nur Klassen und hidden.
 * Verhalten: src/scripts/header.ts
 */
import Button from '@luescher/ui/components/Button.astro';
import Icon from '@luescher/ui/components/Icon.astro';
import Logo from '@luescher/ui/components/Logo.astro';
import { addressLine, company, hours, href, nav, primaryCta, sites } from '../config/site.ts';
import { clock } from '../lib/opening-hours.ts';

interface Props {
  /** Auf der Startseite sind die Navigationspunkte Ankerlinks ohne Seitenwechsel. */
  home?: boolean;
}

const { home = false } = Astro.props;
const cta = primaryCta(home);
const link = (hash: string) => (home ? hash : href(`/${hash}`));
const pad = (index: number) => String(index + 1).padStart(2, '0');
---

<header class:list={['site-header', { 'has-note': sites.preview }]} data-header>
  <div class="bar">
    <Logo href={href('/')} class="bar-logo" />

    <nav class="bar-nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={link(item.hash)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="bar-actions">
      <a
        class="bar-phone"
        href={`tel:${company.phone.tel}`}
        aria-label={`Anrufen: ${company.phone.label}`}
      >
        <Icon name="phone" size={18} />
      </a>
      {/* Eigene Hülle: Sie taucht beim Formwechsel ab, die Übergänge des Buttons bleiben unberührt. */}
      <span class="bar-cta-slot">
        <Button href={cta.href} size="sm" icon class="bar-cta">
          {cta.label}
        </Button>
      </span>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="menu-toggle-label" data-menu-label>
          Menü
        </span>
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
      {/* Ohne JavaScript statt des Knopfs (noscript.css): zur Navigation im Seitenende. */}
      <a class="menu-toggle menu-fallback" href="#seitenende">
        <span class="menu-toggle-label">Menü</span>
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </a>
    </div>
  </div>

  {/* data-lenis-prevent: Das Menü scrollt selbst, auch wenn die Seite dahinter gesperrt ist. */}
  <div class="menu" id="mobile-menu" data-menu data-lenis-prevent hidden>
    <div class="wrap menu-inner">
      <nav class="menu-nav" aria-label="Menü">
        <ul class="menu-links">
          {nav.map((item, index) => (
            <li>
              <a href={link(item.hash)} data-menu-link>
                <span class="secnum" aria-hidden="true">
                  {pad(index)}
                </span>
                <span class="menu-link-mask">
                  <span class="menu-link-label">{item.label}</span>
                </span>
                <span class="orb" aria-hidden="true">
                  <Icon name="arrow-right" size={20} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="menu-foot">
        <Button href={cta.href} block icon data-menu-link>
          {cta.label}
        </Button>
        <dl class="menu-contact">
          <div>
            <dt class="label-up">Telefon</dt>
            <dd>
              <a class="link tabular" href={`tel:${company.phone.tel}`}>
                {company.phone.label}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label-up">E-Mail</dt>
            <dd>
              <a class="link" href={`mailto:${company.email}`}>
                {company.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label-up">Adresse</dt>
            <dd>{addressLine}</dd>
          </div>
        </dl>
        <ul class="menu-hours">
          {hours.map((row) => (
            <li>
              <span>{row.label}</span>
              <span class="mono">
                {row.hours ? `${clock(row.hours.open)}–${clock(row.hours.close)}` : 'geschlossen'}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  /*
   * Fest am Bildschirm, Höhe 0: Der Header belegt keinen Platz, die Leiste schwebt über dem
   * Inhalt. Bewusst nicht «sticky»: Beim Fokus auf ein Element der Leiste würde der Browser die
   * Seite sonst verschieben (er will es aus dem scroll-padding herausholen, was nicht geht).
   */
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    height: 0;
  }

  /* In der Vorschau steht oben ein schmaler Hinweis: Die Leiste rückt darunter. */
  .site-header.has-note {
    top: 1.75rem;
  }

  /*
   * Zentriert über die Ränder, nicht über transform: So liegt die Leiste auf ganzen Pixeln (ein
   * halber Pixel liesse sie bei einem Seitenwechsel weich wirken).
   */
  .bar {
    position: absolute;
    top: 1rem;
    inset-inline: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100% - 2 * var(--gutter), var(--container));
    min-height: 3.5rem;
    margin-inline: auto;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
  }

  /*
   * Beim Seitenwechsel (View Transition, global.css) steht die Leiste still, statt mit der Seite
   * überzublenden. Der Name ist pro Seite einmalig; bei reduzierter Bewegung gibt es keinen
   * Übergang und darum auch keinen Namen.
   * Nur die Leiste oben trägt ihn, nie die Kapsel: Der Browser würde die Kapsel sonst beim Wechsel
   * auf die Grösse der Leiste ziehen (Logo und Knöpfe verzerrt). Und ein Element mit Namen grenzt
   * die Unschärfe seiner Kinder ab: Das Milchglas der Kapsel (::before) bliebe klar.
   * Aus demselben Grund verliert die Leiste den Namen, wenn die neue Seite nicht sicher oben
   * beginnt (Marke oder Verlauf, is-leaving aus header.ts).
   * Die Kapsel trägt einen eigenen Namen, aber nur während eines Seitenwechsels (is-handing aus
   * header.ts): Kommen alte und neue Seite als Kapsel, bilden die beiden ein Paar gleicher Grösse
   * und bleiben stehen, statt mit ihren Seiten aus- und einzublenden. Das Milchglas ist dafür
   * diese halbe Sekunde lang nur mattes Papier (82 % deckend, kaum zu sehen).
   */
  @media (prefers-reduced-motion: no-preference) {
    .site-header:not(:global(.is-scrolled), :global(.is-leaving)) .bar {
      view-transition-name: site-bar;
    }

    .site-header:global(.is-scrolled.is-handing) .bar {
      view-transition-name: site-capsule;
    }
  }

  /*
   * Formwechsel Leiste ↔ Kapsel in zwei Phasen (header.ts): Erst tauchen die Teile kurz nach oben
   * ab (--dur-1), dann wechselt die Form, und die Teile kommen sofort gestaffelt wieder (--dur-3,
   * bremsend): das Logo zuerst, die Navigation 20 ms, die Knöpfe ab 20 ms im Abstand
   * --stagger-tight. In der Kapsel faltet sich gleichzeitig die Fläche auf. Nach gut einer halben
   * Sekunde ruht alles.
   * Die Leiste selbst bleibt sichtbar; Breite und Abstände springen nur, solange alles abgetaucht
   * ist. Telefon und Menü-Knopf führen dieselben Übergänge neben ihren Farben (siehe unten).
   */
  .bar :global(.bar-logo),
  .bar-nav,
  .bar-cta-slot {
    transition:
      opacity var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s),
      transform var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s);
  }

  .bar-nav {
    --bar-delay: 20ms;
  }

  .bar-actions > * {
    --bar-delay: calc(20ms + var(--bar-i, 0) * var(--stagger-tight));
  }

  .bar-actions > :nth-child(2) {
    --bar-i: 1;
  }

  .bar-actions > :nth-child(3) {
    --bar-i: 2;
  }

  /*
   * Beim Abtauchen blendet die Deckkraft gleichmässig (linear) aus, die kleine Bewegung nach oben
   * bremst (--ease-out): Schon im ersten Bild ist eine Antwort zu sehen, und leer ist der Header
   * erst in den letzten Bildern vor dem Wechsel. Mit einer bremsenden Deckkraft wäre er nach der
   * halben Zeit leer und bliebe es bis zum Ende des Übergangs (gemessen sieben Bilder).
   * Die Liste folgt der Reihenfolge der Übergänge: opacity, transform (bei Telefon und Menü-Knopf
   * zuerst die beiden Farben, sie erhalten dieselbe Folge).
   */
  .site-header:global(.is-morphing) :global(.bar-logo),
  .site-header:global(.is-morphing) .bar-nav,
  .site-header:global(.is-morphing) .bar-actions > * {
    opacity: 0;
    transform: translateY(-0.25rem);
    transition-duration: var(--dur-1);
    transition-timing-function: linear, var(--ease-out);
    transition-delay: 0s;
  }

  /*
   * Was den Tastaturfokus trägt, taucht nicht ab: Fokusring und Ziel bleiben während des Abtauchens
   * sichtbar (WCAG 2.4.7), auch ein Link der Navigation. Gibt es das Element in der neuen Form
   * nicht, übernimmt beim Wechsel ein sichtbares Gegenstück den Fokus (header.ts). Es steht sofort
   * ganz da, statt mit den anderen Teilen gestaffelt einzublenden.
   */
  .site-header:global(.is-morphing) :global(.bar-logo):focus-visible,
  .site-header:global(.is-morphing) .bar-nav:has(:focus-visible),
  .site-header:global(.is-morphing) .bar-actions > :is(:focus-visible, :has(:focus-visible)) {
    opacity: 1;
    transform: none;
    transition-duration: 0s;
    transition-delay: 0s;
  }

  /* Nur Deckkraft und Lage stehen sofort; die Farben beim Hover gleiten weiter. */
  .bar :global(.bar-logo):focus-visible,
  .bar-nav:has(:focus-visible),
  .bar-actions > :is(:focus-visible, :has(:focus-visible)) {
    --bar-dur: 0s;
    --bar-delay: 0s;
  }

  /*
   * Im ersten Bild nach dem Wechsel ist die Leiste verborgen (header.ts nimmt die Klasse ein Bild
   * später weg). Zu sehen ist in diesem Moment ohnehin nichts, aber so zählt der Browser den
   * Sprung von Breite und Lage nicht als Layoutverschiebung (CLS). Nur was den Tastaturfokus
   * trägt, bleibt zu sehen (WCAG 2.4.7): visibility lässt sich für ein Kind wieder aufheben.
   */
  .site-header:global(.is-swapping) .bar {
    visibility: hidden;
  }

  .site-header:global(.is-swapping) .bar :focus-visible {
    visibility: visible;
  }

  /* ---------- Navigation (nur Desktop, nur oben) ---------- */

  /* Mitten in der Leiste, ebenfalls über die Ränder zentriert (ganze Pixel). */
  .bar-nav {
    position: absolute;
    inset-inline: 0;
    display: none;
    width: max-content;
    margin-inline: auto;
  }

  .bar-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.125rem, 0.8vw, 0.75rem);
  }

  .bar-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: var(--r-pill);
    color: var(--charcoal);
    font-size: var(--fs-meta);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-1) var(--ease);
  }

  .bar-nav a:hover {
    color: var(--leaf-deep);
  }

  /* Rund, nur das Symbol: Anrufen ist für viele der schnellste Weg. */
  .bar-phone {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--steel);
    border-radius: 50%;
    background-color: rgb(var(--paper-rgb) / 0.6);
    color: var(--charcoal);
    transition:
      border-color var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease),
      opacity var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s),
      transform var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s);
  }

  .bar-phone:hover {
    border-color: var(--leaf-deep);
    background-color: var(--paper);
  }

  /* Oben wird das Logo auf schmalen Handys kleiner, damit Logo und Knöpfe auf eine Zeile passen. */
  .bar :global(.bar-logo) {
    --logo-h: clamp(2rem, 1.2rem + 3.5vw, 2.75rem);
  }

  /* Unter 360 px reicht der Platz nicht für alle drei: Anrufen steht dann im Menü. */
  @media (max-width: 22.49rem) {
    .bar-phone {
      display: none;
    }
  }

  /* ---------- Aktionen ---------- */

  .bar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Oben und schmal: Der CTA steht im Menü, in der Kapsel erscheint er wieder. */
  .bar-cta-slot {
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 1.125rem 1rem;
    border: 1px solid var(--steel);
    border-radius: var(--r-pill);
    background-color: rgb(var(--paper-rgb) / 0.6);
    color: var(--charcoal);
    font-size: var(--fs-meta);
    font-weight: 600;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    transition:
      border-color var(--dur-2) var(--ease),
      background-color var(--dur-2) var(--ease),
      opacity var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s),
      transform var(--bar-dur, var(--dur-3)) var(--ease-out) var(--bar-delay, 0s);
  }

  .menu-toggle:hover {
    border-color: var(--leaf-deep);
  }

  .menu-bars {
    position: relative;
    display: block;
    width: 1rem;
    height: 0.625rem;
  }

  .menu-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform var(--dur-2) var(--ease);
  }

  .menu-bars span:first-child {
    top: 1px;
  }

  .menu-bars span:last-child {
    bottom: 1px;
  }

  .menu-toggle[aria-expanded='true'] .menu-bars span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-bars span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ---------- Kapsel (gescrollt) ---------- */

  .site-header:global(.is-scrolled) .bar {
    top: 0.75rem;
    gap: 0.375rem;
    width: max-content;
    max-width: calc(100% - 2 * var(--gutter));
    min-height: 0;
    padding: 0.375rem;
  }

  /*
   * Die Fläche der Kapsel liegt auf eigenen Ebenen hinter dem Inhalt: ::before trägt Glas, Rand
   * und Unschärfe und faltet sich nach dem Wechsel aus der Mitte seitlich auf (clip-path, weich
   * bremsend). ::after trägt nur den Schatten und blendet etwas später ein: So schneidet der Clip
   * den Schatten nie ab, und box-shadow selbst wird nie animiert. inset: -1px deckt den
   * transparenten Rand der Leiste, die Kapsel ist also genau so gross wie bisher.
   */
  .site-header:global(.is-scrolled) .bar::before,
  .site-header:global(.is-scrolled) .bar::after {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border-radius: inherit;
    content: '';
    pointer-events: none;
  }

  .site-header:global(.is-scrolled) .bar::before {
    border: 1px solid var(--hairline);
    background-color: rgb(var(--paper-rgb) / 0.82);
    clip-path: inset(0 round var(--r-pill));
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    backdrop-filter: blur(16px) saturate(1.4);
    transition:
      clip-path 360ms var(--ease-expo),
      opacity var(--dur-1) var(--ease-out);
  }

  .site-header:global(.is-scrolled) .bar::after {
    box-shadow: 0 0.75rem 2rem rgb(var(--charcoal-rgb) / 0.1);
    transition: opacity var(--dur-3) var(--ease-out) 60ms;
  }

  @starting-style {
    .site-header:global(.is-scrolled) .bar::before {
      clip-path: inset(0 10% round var(--r-pill));
      opacity: 0;
    }

    .site-header:global(.is-scrolled) .bar::after {
      opacity: 0;
    }
  }

  /*
   * Ohne Formwechsel (Sprung, angehaltene Bewegung, header.ts): Die Kapsel steht sofort samt
   * Fläche und Schatten da, statt sich hinter den schon sichtbaren Knöpfen erst aufzufalten.
   */
  .site-header:global(.is-instant) .bar::before,
  .site-header:global(.is-instant) .bar::after {
    transition: none;
  }

  /* Zurück zur Leiste: Die Kapsel faltet sich zusammen, während ihr Inhalt abtaucht. */
  /* Wie der Inhalt: Der Clip bremst, die Deckkraft geht gleichmässig (Reihenfolge wie oben). */
  .site-header:global(.is-scrolled.is-morphing) .bar::before {
    clip-path: inset(0 10% round var(--r-pill));
    opacity: 0;
    transition-duration: var(--dur-1);
    transition-timing-function: var(--ease-out), linear;
  }

  .site-header:global(.is-scrolled.is-morphing) .bar::after {
    opacity: 0;
    transition: opacity var(--dur-1) linear;
  }

  .site-header:global(.is-scrolled) .bar-nav {
    display: none;
  }

  /* In der Kapsel wird das Logo kleiner; auf schmalen Bildschirmen bleibt es weg. */
  .site-header:global(.is-scrolled) :global(.bar-logo) {
    --logo-h: 1.75rem;
    margin-inline: 0.75rem 0.375rem;
  }

  @media (max-width: 29.99rem) {
    .site-header:global(.is-scrolled) :global(.bar-logo) {
      display: none;
    }
  }

  .site-header:global(.is-scrolled) .bar-actions {
    gap: 0.375rem;
  }

  .site-header:global(.is-scrolled) .bar-cta-slot {
    display: flex;
  }

  .site-header:global(.is-scrolled) .menu-toggle {
    width: 2.75rem;
    padding: 0;
  }

  /* Nur ohne JavaScript zu sehen (noscript.css). */
  .bar-actions .menu-fallback {
    display: none;
    text-decoration: none;
  }

  /* In der Kapsel trägt der runde Knopf nur das Symbol; der Name bleibt für Screenreader. */
  .site-header:global(.is-scrolled) .menu-toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Vollbild-Menü ---------- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--linen);
    background-image:
      radial-gradient(60rem 40rem at 100% 0%, rgb(var(--leaf-rgb) / 0.16), transparent 70%),
      radial-gradient(40rem 30rem at 0% 100%, rgb(var(--sage-rgb) / 0.9), transparent 70%);
    clip-path: inset(0);
    transition:
      clip-path var(--dur-3) var(--ease-out),
      display var(--dur-3) allow-discrete;
  }

  /*
   * Vorhang: Das Menü rollt vom Header nach unten aus (560 ms, weich bremsend) und fährt beim
   * Schliessen schneller nach oben zurück (--dur-3, ebenfalls bremsend: Schon im ersten Bild
   * bewegt sich etwas, ein Fingertipp bekommt sofort Antwort). Reines CSS am hidden-Attribut: Dank
   * allow-discrete wird display erst am Ende des Schliessens zu none, @starting-style gibt dem
   * Öffnen seinen Anfang. Browser ohne allow-discrete schalten wie bisher sofort um.
   */
  .menu[hidden] {
    clip-path: inset(0 0 100% 0);
  }

  .menu:not([hidden]) {
    transition-duration: 560ms;
    transition-timing-function: var(--ease-expo);
  }

  @starting-style {
    .menu:not([hidden]) {
      clip-path: inset(0 0 100% 0);
    }
  }

  .menu-inner {
    position: relative;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: calc(var(--header-h) + 1rem) 2rem;
  }

  .menu-links {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .menu-links a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    padding-block: clamp(0.625rem, 1.6svh, 1.25rem);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  /*
   * Maske der grossen Menüwörter, wie .ln-mask bei den Überschriften: Sie reicht etwas über die
   * Zeile hinaus, damit Umlaute nicht abgeschnitten werden. Die Schriftgrösse sitzt hier, damit
   * sich 0.2em auf das grosse Wort bezieht. Der Fokusring liegt am Link und bleibt ganz.
   */
  .menu-link-mask {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.2em;
    font-size: clamp(2rem, 1rem + 5.4vw, 5rem);
    line-height: 1;
  }

  .menu-link-label {
    display: block;
    color: var(--charcoal);
    font-weight: var(--fw-display);
    letter-spacing: var(--ls-display);
    text-transform: uppercase;
    transition: color var(--dur-2) var(--ease);
  }

  /*
   * Hinter dem Vorhang steigen die Wörter Zeile für Zeile aus ihrer Maske (ab 70 ms im Abstand
   * --stagger-tight, während der Vorhang noch ausrollt), die runden Pfeile folgen je 40 ms später,
   * der Kontaktblock setzt sich zuletzt. Die Animationen beginnen bei jedem Öffnen neu; beim
   * Schliessen trägt der Vorhang alles allein.
   */
