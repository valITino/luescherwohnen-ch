---
/**
 * Kopf einer Sektion: Kicker («01 / …»), riesige H2 in Versalien und optionaler Einleitungstext.
 * Beim Hereinscrollen steigen die Zeilen der Überschrift aus ihrer Maske, Kicker und Einleitung
 * rücken nach (scroll.css): alles an der Scrollposition, nichts nach Zeit.
 */
import Kicker from '@luescher/ui/components/Kicker.astro';
import Words from '@luescher/ui/components/Words.astro';
import { plainText } from '@luescher/ui/lib/text';

interface Props {
  /** Abschnittsnummer, z. B. '01'. Ohne Angabe entfällt die Nummer. */
  num?: string;
  kicker?: string;
  title: string;
  /** id der Überschrift, für aria-labelledby an der Sektion */
  id: string;
  lead?: string;
  /** `split`: Überschrift links, Einleitung rechts (ab Desktop) */
  layout?: 'stack' | 'split';
  /** `xl` für die ganz grossen Auftritte */
  size?: 'l' | 'xl';
  class?: string;
}

const {
  num,
  kicker,
  title,
  id,
  lead,
  layout = 'stack',
  size = 'l',
  class: className,
} = Astro.props;
---

<header class:list={['section-head', { 'section-head-split': layout === 'split' }, className]}>
  <div class="section-head-main">
    {kicker && (
      <Kicker num={num} class="sc-rise section-kicker">
        {kicker}
      </Kicker>
    )}
    {/* Die Wörter sind für Screenreader stumm (Words.astro), der Name steht im aria-label. */}
    <h2
      id={id}
      class:list={['display', size === 'xl' ? 'h1' : 'h2', 'section-title']}
      aria-label={plainText(title)}
    >
      <Words text={title} />
    </h2>
  </div>
  {lead && <p class="lead section-lead sc-rise">{lead}</p>}
  <slot />
</header>

<style>
  .section-head {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .section-head-main {
    display: grid;
    gap: clamp(0.875rem, 1.6vw, 1.25rem);
  }

  .section-title {
    max-width: 17em;
  }

  /* Der Kicker ist so breit wie sein Text und rückt nur wenig nach. */
  .section-head-main :global(.section-kicker) {
    --sc-y: 1.25rem;

    justify-self: start;
  }

  .section-lead {
    max-width: 26em;
    color: var(--fg-muted);
  }

  @media (min-width: 64rem) {
    .section-head-split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }

    .section-head-split .section-lead {
      padding-bottom: 0.35em;
    }
  }
</style>
