---
import '../styles/global.css';
import BaseHead from '@luescher/ui/components/BaseHead.astro';
import PreviewNote from '@luescher/ui/components/PreviewNote.astro';
import {
  breadcrumbs,
  graph,
  organization,
  store,
  webPage,
  website,
} from '@luescher/ui/lib/structured-data';
import Chrome from '../components/Chrome.astro';
import { clock } from '../lib/opening-hours.ts';
import { absoluteUrl, basePath, brand, company, hours, href, meta, sites } from '../config/site.ts';

interface Props {
  title: string;
  description?: string;
  /** Pfad der Seite ohne Basis, z. B. '/' oder '/impressum' */
  path: string;
  noindex?: boolean;
  ogImage?: string;
  bodyClass?: string;
  /** Fortschritts-Anzeige am Rand (Startseite) */
  progress?: boolean;
  /** Name der Seite im Pfad «Startseite › …» (strukturierte Daten); auf Unterseiten setzen */
  crumb?: string;
}

const {
  title,
  description = meta.defaultDescription,
  path,
  noindex = false,
  ogImage = meta.ogImage,
  bodyClass,
  progress = false,
  crumb,
} = Astro.props;

const url = absoluteUrl(path);
const home = absoluteUrl('/');
const isHome = path === '/';
const hidden = noindex || sites.preview;
const language = 'de-CH';

const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

// Strukturierte Daten: Organisation, Geschäft und Website einmal auf der Startseite, jede Seite
// beschreibt sich selbst und verweist darauf. Seiten ausserhalb des Index tragen keine.
const jsonLd = hidden
  ? undefined
  : graph(
      isHome && organization(brand),
      isHome &&
        store({
          home,
          type: 'FurnitureStore',
          name: company.name,
          url: home,
          image: absoluteUrl(ogImage),
          telephone: company.phone.tel,
          email: company.email,
          address: {
            street: company.street,
            zip: company.zip,
            city: company.city,
            countryCode: company.countryCode,
          },
          hours: hours.flatMap((row) =>
            row.hours
              ? [
                  {
                    days: row.days.map((day) => DAY_NAMES[day] ?? ''),
                    opens: clock(row.hours.open),
                    closes: clock(row.hours.close),
                  },
                ]
              : [],
          ),
        }),
      isHome &&
        website({
          url: home,
          name: company.short,
          alternateName: brand.alternateName,
          description: brand.description,
          language,
          publisherHome: home,
        }),
      webPage({
        url,
        name: title,
        description,
        language,
        siteUrl: home,
        publisherHome: home,
        image: absoluteUrl(ogImage),
        aboutOrganization: isHome,
        breadcrumb: Boolean(crumb),
      }),
      crumb
        ? breadcrumbs(url, [
            { name: 'Startseite', url: home },
            { name: crumb, url },
          ])
        : null,
    );
---

<!doctype html>
<html lang="de-CH">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonical={url}
      ogImage={absoluteUrl(ogImage)}
      noindex={hidden}
      base={basePath}
      jsonLd={jsonLd}
      verification={sites.verification}
    />
    <slot name="head" />
    {/* Ohne JavaScript: Header ohne Kapsel und Menü (noscript.css). */}
    <noscript>
      <link rel="stylesheet" href={href('/noscript.css')} />
    </noscript>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#inhalt">
      Zum Inhalt springen
    </a>
    {sites.preview && <PreviewNote />}
    <slot name="header" />
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <Chrome progress={progress} />
  </body>
</html>
